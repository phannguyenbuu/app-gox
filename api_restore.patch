 1;\r\n    }\r\n    else\r\n        gotlayers = 1;\r\n\r\n    if (NS4) {\r\n        window.captureEvents(Event.MOUSEMOVE);\r\n        window.onmousemove=move;\r\n    }\r\n    else if (DOM) {\r\n        document.onmousemove=move;\r\n    }\r\n}\r\n\r\nfunction move(e) {\r\n    e = (DOM && IE4) ? event : e;\r\n\r\n    if (NS4)\r\n    {\r\n        if (e.pageX > 225)\r\n        {\r\n            if (1 == top.giIsContentLoaded)\r\n                change(\"\", 1);\r\n        }\r\n    }\r\n    else\r\n    {\r\n        var scrollVal = 0;\r\n        if (document.body.scrollLeft)\r\n            scrollVal = document.body.scrollLeft;\r\n        else if (window.scrollX)\r\n            scrollVal = window.scrollX;\r\n\r\n        if (e.clientX + scrollVal > 225)\r\n        {\r\n            if (1 == top.giIsContentLoaded)\r\n                change(\"\", 1);\r\n        }\r\n    }\r\n}\r\n\r\nfunction popUp(menuName,on,anch) {\r\n    var liBaseLeft = 0;\r\n    try{\r\n    if (menuName == 'fileKick' || menuName == 'editKick' || menuName == 'viewKick' || menuName == 'layoutKick')\r\n    {\r\n        if (gotlayers) {\r\n            if (on && anch != 'undefined') {\r\n                if (NS4) {\r\n                    if(parent.frames[1].document.layers[menuName]!=undefined && parent.frames[1].document.layers[menuName]!=null){\r\n                        parent.frames[1].document.layers[menuName].visibility = \"show\";\r\n                    }\r\n                } else if (DOM) {\r\n                    if (menuName == 'fileKick')\r\n                        liBaseLeft = 4;\r\n                    if (menuName == 'editKick')\r\n                        liBaseLeft = 58;\r\n                    if (menuName == 'viewKick')\r\n                        liBaseLeft = 117;\r\n                    if (menuName == 'layoutKick')\r\n                        liBaseLeft = 181;\r\n\r\n                    if(parent.frames[1].document.getElementById(menuName)!=undefined && parent.frames[1].document.getElementById(men