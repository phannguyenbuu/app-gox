        {\n                switch(main){\n                    case \"LOGIN\":\n                        if(status==\"tmpUserAuthDisableLogin\" || status==\"tmpSLogin\"){\n                            top.fnSetCookie(\"LOGINSTATUS\",null, -30);\n                        }\n                        else {\n                            top.fnSetCookie(\"SESSID\",null, -30);\n                            top.fnSetCookie(\"LOGINSTATUS\",null, -30);\n                            top.fnSetCookie(\"USERROLE\",null, -30);\n                            top.fnSetCookie(\"LOGINMODE\",null, -30);\n                        }\n                        main=\"TopAccessLogin.html?v=1503272377ta\";\n                        break;\n                    case \"EMAIL\":\n                        //to block  user intention to open Emailnotify.html?v=1503272377ta thru URL i.e., .../?MAIN=EMAIL unless he went thru forgotPwd process.\n                        if (status==\"tmpForgotPwd\")\n                            main=\"Administration/EmailNotify.html?v=1503272377ta\";\n                        else {\n                            top.fnSetClientCookie(\"pageTrack\",\"MAIN=LOGIN\");\n                        }\n                        break;\n                    case \"PWDRST\":\n                        if (sessionID != null && sessionID != \"\"){\n                            main=\"Administration/PasswordResetExpireTentative.html?v=1503272377ta\";\n                        }\n                        else{\n                            top.fnSetClientCookie(\"pageTrack\",\"MAIN=LOGIN\");\n                            top.location.replace(window.location.protocol+\"//\"+((window.location.hostname.indexOf(\":\") != -1 && window.location.hostname.indexOf(\"]\") == -1)?((\"[\"+window.location.hostname+\"]\")+((window.location.port != \"\")? \":\"+window.location.port : \"\" )) : window.location.host)+\"/?MAIN=TOPACCESS\");\n                        }\n                        break;\n                    case \"EFILING\":\n                        if(status == \"tmpEfilingPwdRst\"){\n                           main=\"Administration/PasswordResetExpireTentative.html?v=1503272377ta\";\n                        }else if(top.fnGetCookie(\"LOGINSTATUS\") == \"tmpEfilingLoginAfterPwdRst\"){\n                           main=\"TopAccessLogin.html?v=1503272377ta\";\n                        }else{\n                            main=\"TopAccessLogin.html?v=1503272377ta\";\n                        }\n                        break ;\n                    default      :\n                        top.fnSetCookie(\"SESSID\",null, -30);\n                        top.fnSetCookie(\"LOGINSTATUS\",null, -30);\n                        top.fnSetCookie(\"USERROLE\",null, -30);\n                        top.fnSetCookie(\"LOGINMODE\",\"SECURED\");\n                        top.fnSetClientCookie(\"pageTrack\",\"MAIN=LOGIN\");\n                        top.location.replace(window.location.protocol+\"//\"+((window.location.hostname.indexOf(\":\") != -1 && window.location.hostname.indexOf(\"]\") == -1)?((\"[\"+window.location.hostname+\"]\")+((window.location.port != \"\")? \":\"+window.location.port : \"\" )) : window.location.host)+\"/?MAIN=TOPACCESS\");\n                }\n            }\n        if(loginMode == \"SECURED\" && window.location.protocol.toLowerCase() == \"https:\") {\n            setTimeout(\"fnWriteFrameSetLogin(\\\"\" + main + \"\\\")\", 0);\n        }else{\n            document.write('<frameset name=\"TAframeSet\" ROWS=\"*,20\" framespacing=\"0\" frameborder=\"1\" border=\"1\" width=\"700\" framespacing=\"0\"><frame name=\"Loginframe\" SRC=\"'+main+'\" width=\"100%\" marginheight=\"0\" marginwidth=\"0\" frameborder=\"0\" border=\"0\" scrolling=\"auto\" title=\"Login\"><frame name=\"footer\" SRC=\"Footer.html?v=1503272377ta\" width=\"100%\" frameborder=\"0\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"no\" noresize></frameset>');\n        }\n\n        } else {\n            if((status ==\"PasswordReset\" || status ==\"PasswordExpired\" || status ==\"PasswordPolicyExpired\") && (loginMode == \"NORMAL\")){\n            //document.write('<frameset name=\"TAframeSet\" ROWS=\"*,20\" framespacing=\"0\" frameborder=\"1\" border=\"1\" width=\"700\" framespacing=\"0\"><frame name=\"Loginframe\" SRC=\"Administration/PasswordReset.html?v=1503272377ta\" width=\"100%\" marginheight=\"0\" marginwidth=\"0\" frameborder=\"0\" border=\"0\" scrolling=\"no\" title=\"Login\"><frame name=\"footer\" SRC=\"Footer.html?v=1503272377ta\" width=\"100%\" frameborder=\"0\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"no\" noresize></frameset>');\n                document.write('<frameset name=\"TAframeSet\" ROWS=\"*,20\" framespacing=\"0\" frameborder=\"1\" border=\"1\" width=\"700\" framespacing=\"0\"><frame name=\"Loginframe\" SRC=\"Administration/PasswordResetExpireTentative.html?v=1503272377ta\" width=\"100%\" marginheight=\"0\" marginwidth=\"0\" frameborder=\"0\" border=\"0\" scrolling=\"auto\" title=\"Login\"><frame name=\"footer\" SRC=\"Footer.html?v=1503272377ta\" width=\"100%\" frameborder=\"0\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"no\" noresize></frameset>');\n            }\n            else{\n                var heightOfFrm = 96;\n                var useSetTimeoutFlag = false;\n                var cokVal = top.fnGetClientCookie(\"IgnoreSessionTimeout\");\n                //alert(\"cokVal:\"+cokVal);\n                if(window.location.protocol.toLowerCase() == \"https:\" && (cokVal == \"0\" || cokVal == \"\")){\n                    useSetTimeoutFlag = true;                    \n                }\n                //alert(\"useSetTimeoutFlag=\"+useSetTimeoutFlag +\" protocol=\"+window.location.protocol.toLowerCase() +\"    ig=\"+cokVal);\n                top.fnSetCookie(\"IgnoreSessionTimeout\",\"1\");\n                if(main==\"EFILING\"){\n                    var efilingOpen = top.fnGetCookie(\"efilingOpen\"); //)==\"\"?top.fnSetCookie(\"efilingOpen\",\"1\"):\n\n                    if(efilingOpen == \"\"){\n                        top.fnSetCookie(\"efilingOpen\",\"1\");\n                        top.location.replace(window.location.protocol+\"//\"+((window.location.hostname.indexOf(\":\") != -1 && window.location.hostname.indexOf(\"]\") == -1)?((\"[\"+window.location.hostname+\"]\")+((window.location.port != \"\")? \":\"+window.location.port : \"\" )) : window.location.host)+\"/?MAIN=EFILING\");\n\n                    }\n                    else{\n                        top.fnSetCookie(\"efilingOpen\",null,-30);\n                    if(top.fnGetCookie(\"SECURITYLEVEL\")==\"HIGH\" && fnIsIEBrowser())\n                        document.open();\n                    document.write('<frameset name=\"TAframeSet\"framespacing=\"0\" frameborder=\"0\" border=\"0\" width=\"700\" framespacing=\"0\"><frame name=\"topframe1\" SRC=\"/efiling/Efb.html?v=1503272377ta\" width=\"100%\" marginheight=\"0\" marginwidth=\"0\" frameborder=\"0\" border=\"0\" scrolling=\"no\" noresize framespacing=\"0\" title=\"efiling\"></frameset>');\n                    }\n                }else{\n                    var IsScroll=\"no\";\n                    if(window.screen.width <=800) {\n                        IsScroll=\"auto\";\n                    }\n                    if(main == \"\") {\n                        top.fnSetClientCookie(\"pageTrack\", \"MAIN=DEVICE\");\n                        top.location.replace(window.location.protocol + \"//\" + ((window.location.hostname.indexOf(\":\") != -1 && window.location.hostname.indexOf(\"]\") == -1) ? ((\"[\" + window.location.hostname + \"]\") + ((window.location.port != \"\") ? \":\" + window.location.port : \"\" )) : window.location.host) + \"/?MAIN=TOPACCESS\");\n                    }\n                    else{\n                        if(useSetTimeoutFlag){\n\t\t\t\t\t        setTimeout(\"fnWriteFrameset('\"+heightOfFrm+\"','\"+IsScroll+\"')\",0);\n                        }\n                        else{\n                            if(top.fnGetCookie(\"SECURITYLEVEL\")==\"HIGH\" && fnIsIEBrowser())\n                                document.open();\n                            document.write('<frameset name=\"TAframeSet\" ROWS='+heightOfFrm+',30,*,20 framespacing=\"0\" frameborder=\"0\" border=\"0\" width=\"700\" framespacing=\"0\"><frame name=\"topframe\" SRC=\"TopMenu.html?v=1503272377ta\" width=\"100%\" marginheight=\"0\" marginwidth=\"0\" frameborder=\"0\" border=\"0\" scrolling=\"'+IsScroll+'\" noresize framespacing=\"0\" title=\"Main Menu\"><frame id=\"SubMenu\" name=\"SubMenu\" SRC=\"\" width=\"100%\" frameborder=\"0\" framespacing=\"0\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"no\" noresize><frame name=\"contents\" SRC=\"\" width=\"100%\" frameborder=\"0\" framespacing=\"0\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"auto\"><frame name=\"footer\" SRC=\"Footer.html?v=1503272377ta\" width=\"100%\" frameborder=\"0\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"no\" noresize></frameset>');\n                        }\n\t\t\t\t\t}\n                }\n            }\n        }\n\n        document.close();\n    }\n    function fnWriteFrameSetLogin(main) {\n        fnSetClientCookie(\"pageTrack\",\"MAIN=LOGIN\");\n        if(top.fnGetCookie(\"SECURITYLEVEL\")==\"HIGH\" && fnIsIEBrowser())\n            document.open();\n        document.write('<frameset name=\"TAframeSet\" ROWS=\"*,20\" framespacing=\"0\" frameborder=\"1\" border=\"1\" width=\"700\" framespacing=\"0\"><frame name=\"Loginframe\" SRC=\"'+main+'\" width=\"100%\" marginheight=\"0\" marginwidth=\"0\" frameborder=\"0\" border=\"0\" scrolling=\"auto\" title=\"Login\"><frame name=\"footer\" SRC=\"Footer.html?v=1503272377ta\" width=\"100%\" frameborder=\"0\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"no\" noresize></frameset>');\n\n    /*var loginFrame = document.getElementById('Loginframe');\n    var footerFrame = document.getElementById('footer');\n    if(loginFrame!=undefined && loginFrame!=null){\n        loginFrame.src = main;\n    }\n    if(footerFrame!=undefined && footerFrame!=null) {\n        footerFrame.src = \"Footer.html?v=1503272377ta\";\n    }*/\n    }\n    function fnWriteFrameset(heightOfFrm,IsScroll){\n        top.fnSetClientCookie(\"pageTrack\", \"MAIN=DEVICE\");\n        document.write('<frameset name=\"TAframeSet\" ROWS='+heightOfFrm+',30,*,20 framespacing=\"0\" frameborder=\"0\" border=\"0\" width=\"700\" framespacing=\"0\"><frame name=\"topframe\" SRC=\"TopMenu.html?v=1503272377ta\" width=\"100%\" marginheight=\"0\" marginwidth=\"0\" frameborder=\"0\" border=\"0\" scrolling=\"'+IsScroll+'\" noresize framespacing=\"0\" title=\"Main Menu\"><frame id=\"SubMenu\" name=\"SubMenu\" SRC=\"\" width=\"100%\" frameborder=\"0\" framespacing=\"0\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"no\" noresize><frame name=\"contents\" SRC=\"\" width=\"100%\" frameborder=\"0\" framespacing=\"0\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"auto\"><frame name=\"footer\" SRC=\"Footer.html?v=1503272377ta\" width=\"100%\" frameborder=\"0\" marginheight=\"0\" marginwidth=\"0\" scrolling=\"no\" noresize></frameset>');\n\t}\n    // Returns the version of Windows Internet Explorer or a -1\n    // (indicating the use of another browser).\n    function IsIE8Browser() {\n        var RetrnVlu = -1;\n        var UserAgent = navigator.userAgent;\n        var RegulrExp = new RegExp(\"Trident\\/([0-9]{1,}[\\.0-9]{0,})\");\n        if (RegulrExp.exec(UserAgent) != null) {\n            RetrnVlu = parseFloat(RegExp.$1);\n        }\n        return RetrnVlu;\n    }\n    function SafariVersion() {\n        var RetrnVlu = -1;\n        var UserAgent = navigator.userAgent;\n        var RegulrExp = new RegExp(\"Version\\/([0-9]{1,}[\\.0-9]{0,})\");\n        if (RegulrExp.exec(UserAgent) != null) {\n            RetrnVlu = parseFloat(RegExp.$1);\n        }\n        return RetrnVlu;\n    }\n\n    function fnHandleIsLoginRequired(xmlDoc){\n       //alert(\"inside fnHandleIsLoginRequired()\");\n        var statusOperLoginReq;\n        var statusOperSecLevel;\n        statusOperLoginReq = getXpathValue(xmlDoc,\"LoginRequired/Response/statusOfOperation\");\n        statusOperSecLevel = getXpathValue(xmlDoc,\"GetSecurityConfiguration/Response/statusOfOperation\");\n\n        var loginMode = \"\";\n        var secLevel = \"\";\n       //alert(statusOperLoginReq)\n        var status08 = getXpathValue(xmlDoc,\"GetDiagnosticMode/Response/statusOfOperation\");\n        if(status08 == \"Normal\") {\n            top.fnTrackCookie(\"DiagnosticMode\",\"SET\",\"9003\", getXpathValue(xmlDoc,\"DiagnosticMode/Category/MainCode/ValueList/Value/Value\"));\n        }\n        //top.fnTrackCookie(\"DiagnosticMode\",\"SET\",\"9003\", \"1\");\n        if(statusOperLoginReq == AuthStatusConstants[\"STATUS_OK\"] && statusOperSecLevel == AuthStatusConstants[\"STATUS_OK\"]){\n            top.fnSetCookie(\"LOGINSTATUS\",null,-30);\n\n            loginMode = getXpathValue(xmlDoc,\"SecuritySettings/isLoginReqd\");\n            secLevel = getXpathValue(xmlDoc,\"SecuritySettings/securityLevel\");\n\n            if(loginMode!=\"\")\n                top.fnSetClientCookie(\"retryCount\",null, -30,\"/\");\n\n            if(secLevel == \"1\"){\n                top.fnSetCookie(\"SECURITYLEVEL\",\"LOW\");\n            }\n            else if(secLevel == \"2\"){\n                top.fnSetCookie(\"SECURITYLEVEL\",\"MODERATE\");\n            }\n            else if(secLevel == \"3\"){\n                top.fnSetCookie(\"SECURITYLEVEL\",\"HIGH\");\n            }\n            if(loginMode == \"TRUE\"){\n                top.fnSetClientCookie(\"pageTrack\",\"MAIN=LOGIN\");\n                fnRenderTopAccess(\"SECURED\");\n            }\n            else if(loginMode == \"FALSE\"){\n                top.fnSetCookie(\"LOGINMODE\",\"NORMAL\");\n                top.fnSetClientCookie(\"pageTrack\",\"MAIN=DEVICE\");\n                fnRenderTopAccess(null);\n            }\n            else if(loginMode == \"NOT_INITIALIZED\"){\n                top.fnSetCookie(\"LOGINSTATUS\",\"CreateAdmin\");\n                fnRenderTopAccess(null);\n            }\n            else{\n                var getCount =  top.fnGetClientCookie(\"retryCount\");\n                getCount = (getCount == \"\" || getCount == null)?0:getCount;\n\n                if(getCount<20){\n                    top.fnSetClientCookie(\"retryCount\",getCount++ +\"\");\n                    fnIsLoginRequired();\n                }\n                else{\n                    alert(fnGetLocaleString(\"103472\", \"Internal Error has occurred. Please try again.\"));\n                    top.fnSetClientCookie(\"retryCount\", null, -30, \"/\");\n                }\n\n               //alert(\"Error !! Invalid Security mode from the server\");\n            }\n        }else{\n            alert(fnGetLocaleString(\"103472\",\"Internal Error has occurred. Please try again.\"))\n           //alert(\"Error !! Security Mode or Security Level status of operation is invalid from the server\");\n        }\n    }\nwindow.onload = function() {\n    var securityMode = top.fnGetCookie(\"LOGINMODE\");\n    top.fnSetCookie(\"LocaleOrder\", top.gblLocaleOrder);\n    var pageTrackCookie = top.fnGetClientCookie(\"pageTrack\");\n\n    if (pageTrackCookie == \"\" || pageTrackCookie == \"default\" || securityMode == \"\") {\n        fnIsLoginRequired();\n    } else {\n        fnRenderTopAccess(null);\n    }\n};\n</script>\n</html>",
