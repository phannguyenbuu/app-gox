nitiateServerRequest(\"SETCMDGET\");\r\n    } catch(e){errHandler(e,'getEfilingStatus()','Efiling.js?v=1503272377ta',\"\");}\r\n}\r\n\r\n function redirectEfilingStatus(node) {\r\n    var shipingIdentifier=\"\", digCode9016=\"\", digCode8670=\"\", diag_3654_3 = \"\";\r\n    var efilingEnabled = getXpathValue(node, \"Controller/Settings/AdminSystemSettings/EFiling/eFilingEnabled\");\r\n    top.gblscanEnabler = getXpathValue(node, \"Controller/Software/Licenses/ScanEnabler\");\r\n    //top.gblscanEnabler=\"false\";\r\n    // Assigning strogae Type of MFP (enums are : HDD ,SSD\tand DeviceMemory )\r\n    top.gblStorageType = getXpathValue(node, \"MFP/System/StorageType\");    \r\n    /*var keyCounter_installed = getXpathValue(node, \"MFP/System/KeyCounter/Installation\");\r\n    var coinController_installed= getXpathValue(node, \"MFP/System/CoinController/Installation\");\r\n    var copyRiser_installed = getXpathValue(node, \"MFP/System/CopyRiser/Installation\");     \r\n    if(keyCounter_installed==\"Installed\" || coinController_installed==\"Installed\" || copyRiser_installed==\"Installed\"){\r\n        top.gblPD_TPEnable=true;\r\n    }*/\r\n     var dateFormat=getXpathValue(node,\"Controller/Settings/DateSettings/dateFormat\");\r\n     top.fnSetCookie(\"SELECTEDDATEFORMAT\",dateFormat);\r\n     var deciveModelType= ((temp=getXpathValue(node, \"Controller/Information/deviceName\"))==null?\"\":temp);\r\n     deciveModelType = mfpModelTypeName(deciveModelType);   \r\n     top.gblDeviceModelType = deciveModelType;     \r\n     var Status = getXpathValue(node,\"statusOfOperation\");\r\n        if(Status == \"Normal\") {\r\n            var categoryList = node.getElementsByTagName('Category');\r\n            for (var j=0;j<categoryList.length ;j++ )\r\n            {\r\n                var mode = ((temp = getXpathValue(  categoryList[j],\"Mode\")) == \"\" || temp == null)? \"&nbsp;\" : temp;\r\n                var mainCodeList = categoryList[j].getElementsByTagName('MainCode