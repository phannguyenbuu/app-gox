f=\\\"#\\\" class=\\\"LinkGen\\\" onClick=\\\"return Sort('status');return false;\\\">Status</a></TD>\");\n        boxDataHtml+= \"<img src=\\\"\"+gaPreload[1].src+\"\\\" border=0></a>&nbsp;&nbsp;<a href=\\\"#\\\" class=\\\"LinkGen\\\" onClick=\\\"return Sort('status');return false;\\\">\"+fnGetLocaleString(\"101780\", \"Status\")+\"</a></TD>\";\n    }\n    else\n    {\n        boxDataHtml+=\"\"+fnGetLocaleString(\"101780\", \"Status\")+\"</a></TD>\";\n    }\n    var arrBoxList = node.getElementsByTagName(\"Box\");\n    giNumOfBoxes=arrBoxList.length;\n    arrBoxListObj = new Array(giNumOfBoxes);\n    if (arrBoxList !== undefined && arrBoxList != null && arrBoxList.length > 0){\n        var giCount = 0;\n        var gsBoxName=\"\";\n        var gsUsedDisk=\"\";\n        var gsBoxNum=\"\";\n        var gsBoxMoniker=\"\";\n\n        var orgArray = new Array(giNumOfBoxes);\n        var tempArray = new Array(giNumOfBoxes);\n        var liColNum;\n        var statusObj;\n        var status;\n        var isPwdProtected;\n\n        for(var i=0; i <giNumOfBoxes; i++) {\n            arrBoxListObj[i]=new Array(6);\n            boxId = arrBoxList[i].getAttribute(\"boxNo\");\n            boxObj = arrBoxList[i].getElementsByTagName(\"displayName\")[0];\n            if(boxObj!=null)\n                boxname = (!boxObj.hasChildNodes())? \"Undefined\" : boxObj.childNodes[0].nodeValue  ;\n            //boxname=boxname.replace(/\\s/g, '');\n\n            monikerObj = arrBoxList[i].getElementsByTagName(\"moniker\")[0];\n            if(monikerObj!=null) {\n                moniker = (!monikerObj.hasChildNodes())? \"Undefined\" : monikerObj.childNodes[0].nodeValue  ;\n            }else {\n                moniker=\"Undefined\";\n            }\n            usedCapacityObj = arrBoxList[i].getElementsByTagName(\"size\")[0];\n            if(usedCapacityObj!=null) {\n                usedCapacity = (!usedCapacityObj.hasChildNodes())? \"Undefined\" : usedCapacityObj.childNodes[0].nodeValue  ;\n            } else {\n                usedCapacity=\"&nbsp;\";\n            }\n\n             status=(((temp=getXpathValue(arrBoxList[i],\"boxStatus\")) == null || temp === undefined)? \"\": temp);\n\n            isPwdProtected=(((temp=getXpathValue(arrBoxList[i],\"isPasswordProtected\")) == null || temp === undefined)? \"\": temp);\n\n            arrBoxListObj[i][0] = boxId;\n            arrBoxListObj[i][1] = boxname;\n            arrBoxListObj[i][2] = moniker;\n            arrBoxListObj[i][3] = usedCapacity;\n            arrBoxListObj[i][4] = status;\n            arrBoxListObj[i][5] = isPwdProtected;\n\n            orgArray[i] = new Array(5);\n            orgArray[i][0] = boxId;\n            orgArray[i][1] = boxname;\n            orgArray[i][2] = usedCapacity;\n            orgArray[i][3] = moniker;\n            orgArray[i][4] = status;\n            orgArray[i][5] = isPwdProtected;\n\n            if(lsSV == \"boxnum\")\n            {\n                tempArray[i] = Math.round(boxId);\n                liColNum = \"0\";\n            }\n\n            if(lsSV == \"boxname\")\n            {\n                tempArray[i] = boxname;\n                liColNum = \"1\";\n            }\n            if(lsSV == \"usecap\")\n            {\n                tempArray[i] = Math.round(usedCapacity);\n                liColNum = \"2\";\n            }\n            if(lsSV == \"status\")\n            {\n                tempArray[i] = status;\n                liColNum = \"4\";\n            }\n\n        }\n\n       /* while(giCount < giNumOfBoxes)\n        {\n            gsBoxNum = arrBoxListObj[giCount][0] ;\n            gsBoxName = arrBoxListObj[giCount][1] ;\n            gsBoxMoniker= arrBoxListObj[giCount][2] ;\n            gsUsedDisk = arrBoxListObj[giCount][3] ;\n\n            orgArray[giCount] = new Array(5);\n            orgArray[giCount][0] = gsBoxNum;\n            orgArray[giCount][1] = gsBoxName;\n            orgArray[giCount][2] = gsUsedDisk;\n            orgArray[giCount][3] = gsBoxMoniker;\n            orgArray[giCount][4] = arrBoxListObj[giCount][4];            \n            if(lsSV == \"boxnum\")\n            {\n                tempArray[giCount] = Math.round(gsBoxNum);\n                liColNum = \"0\";\n            }\n\n            if(lsSV == \"boxname\")\n            {\n                tempArray[giCount] = gsBoxName;\n                liColNum = \"1\";\n            }\n            if(lsSV == \"usecap\")\n            {\n                tempArray[giCount] = Math.round(gsUsedDisk);\n                liColNum = \"2\";\n            }\n            if(lsSV == \"status\")\n            {\n                tempArray[giCount] = arrBoxListObj[giCount][4];\n                liColNum = \"3\";\n            }\n\n            giCount = giCount + 1;\n        }//while */\n\n        var liTempArrayLength = tempArray.length;\n        if(lsSV == \"usecap\" || lsSV == \"boxnum\") {\n            tempArray.sort(sortNumbers);\n            if(lsSV == \"boxnum\")\n            {\n                for(i=0;i<liTempArrayLength;++i)\n                {\n                    if(tempArray[i] == 0)\n                    {\n                        //tempArray[i] = \"000\";\n                        tempArray[i] = \"00000\";\n                    }\n                    else if(tempArray[i] >= 1 && tempArray[i] < 10)\n                    {\n                        tempArray[i] = \"00\" + tempArray[i].toString();\n                    }\n                    else if(tempArray[i] >= 10 && tempArray[i] <= 99)\n                    {\n                        tempArray[i] = \"0\" + tempArray[i].toString();\n                    }\n                    else\n                    {\n                        tempArray[i] = tempArray[i].toString();\n                    }\n                }//i\n            }//lsSV\n        }\n\n        else\n        {    \n            tempArray.sort();\n        }\n\n        if(lsST == \"A\")\n        {\n            for( i = 0 ; i<liTempArrayLength ; ++i)\n            {\n                var liOrgArrayLength = orgArray.length;\n\n                for( j = 0 ; j<liOrgArrayLength ; ++j)\n                {         \n                    if(tempArray[i].toString() == orgArray[j][liColNum])\n                    {\n                        lsBoxName[i] = orgArray[j][1];\n                        if (orgArray[j][0] != \"000\" && orgArray[j][0] != \"00000\") {\n                            boxDataHtml+=\"<tr>\";\n                            boxDataHtml+=\"<TD align=left class=\\\"clsElementTable\\\"><input type=checkbox name=Box\" + orgArray[j][0] + \" onclick='return checkBox()'></TD>\";\n\n                            boxDataHtml+=\"<TD align=left class=\\\"clsElementTable\\\"><a href='#' onclick='return fnbOpenPropertyWindow(\\\"\"+orgArray[j][0]+\"\\\",\"+i+\",\\\"\"+orgArray[j][3]+\"\\\",\\\"\"+orgArray[j][5]+\"\\\");'>\" + orgArray[j][0] + \"</A></TD>\";\n                            if (orgArray[j][0] != \"000\" && orgArray[j][0] != \"00000\")\n                            {\n                                if (orgArray[j][1] != '')\n                                    boxDataHtml+=\"<TD align=left class=\\\"clsElementTable\\\"><a href='#' onclick='return fnbOpenPropertyWindow(\\\"\"+orgArray[j][0]+\"\\\",\"+i+\",\\\"\"+orgArray[j][3]+\"\\\",\\\"\"+orgArray[j][5]+\"\\\");'>\" + fnsSpaceTonbsp(fnnFileNameConvertHTML(orgArray[j][1])) + \"</A></TD>\";\n                                else\n                                    boxDataHtml+=\"<TD align=left class=\\\"clsElementTable\\\"><a href='#' onclick='return fnbOpenPropertyWindow(\\\"\"+orgArray[j][0]+\"\\\",\"+i+\",\\\"\"+orgArray[j][3]+\"\\\",\\\"\"+orgArray[j][5]+\"\\\");'>&nbsp;</A></TD>\";\n                            }\n                            /* else\n                                  boxDataHtml+=\"<TD align=left class=\\\"clsElementTable\\\"><a href='#' onclick='return fnbOpenPropertyWindow(\\\"\"+orgArray[j][0]+\"\\\",\\\"\"+orgArray[j][1]+\"\\\",\\\"\"+orgArray[j][3]+\"\\