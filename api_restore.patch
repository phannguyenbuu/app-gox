ation.js?v=1503272377ta\"></script>\r\n\r\n    <script language=\"JavaScript\" type=\"text/javascript\">\r\n\r\n         var lsSessionID=\"\";\r\n         var userRole=\"\";\r\n         var status=\"\";\r\n         var loginMode=\"\";\r\n         var docNameQueryStr = \"\"; //gbl var which contains the arr of all selected document names to pass in query str when fnnCopy() or fnnPaste() is called\r\n        // alert(\"UserRole Cookies  \"+top.fnGetCookie(\"USERROLE\"))\r\n        lsSessionID=  top.fnGetCookie(\"SESSID\");\r\n        userRole =  top.fnGetCookie(\"USERROLE\");\r\n        status =  top.fnGetCookie(\"LOGINSTATUS\");\r\n        loginMode = top.fnGetCookie(\"LOGINMODE\");       \r\n        function fnnTabLoginClick(status)  {\r\n            top.archiveStarted=false;\r\n            if(status == \"Logout\"){             \r\n                  // Removing the opened Box form the Track cookies.\r\n                var splitopenBox =top.trackOpenedBox;\r\n                if(splitopenBox!=null || splitopenBox!=\"\") {\r\n                    splitopenBox=splitopenBox.split(\",\");\r\n                    for(var n=1;n<=splitopenBox.length;n++){\r\n                        if(splitopenBox[n] != null && splitopenBox[n] != \"\"){\r\n                            trackEfilingResources(splitopenBox[n],\"BOX\",\"REMOVE\");\r\n                        }\r\n                    }\r\n                }\r\n                 // Removing the opened folder from the Track cookies.\r\n               var splitopenFolder =top.trackOpenedFolder;\r\n               if(splitopenFolder!=null || splitopenFolder!=\"\") {\r\n                    splitopenFolder=splitopenFolder.split(\",\");\r\n                    for(var n=1;n<=splitopenFolder.length;n++){\r\n                        if(splitopenFolder[n] != null && splitopenFolder[n] != \"\"){\r\n                           trackEfilingResources(splitopenFolder[n],\"FOLDER\",\"REMOVE\");\r\n                        }\r\n                    }\r\n               }\r\n                //send command to logout\r\n                unAuthenticateUser(\"eFilingLogout\");\r\n            }else\r\n                parent.middleframe.location.replace(\"LoginFrame.html?v=1503272377ta\");\r\n\r\n        }\r\n        function refreshEfiling() {\r\n            if(top.glLoginCancel == null ) {\r\n                RefreshPage();\r\n            }/* else {\r\n                top.glLoginCancel = null;\r\n            }*/\r\n        }\r\n\r\n        function fnnTabClick(selected,redirectUrl){\r\n            top.archiveStarted=false;\r\n            top.gblSelectedLink=selected;\r\n            switch(selected){\r\n                case \"Doc\" :\r\n                    fnnShowDiv();\r\n                    document.getElementById(\"Doc\").className=\"clsSubMenu\";\r\n                    document.getElementById(\"Pref\").className=\"TopMenu\";\r\n                    document.getElementById(\"Admin\").className=\"TopMenu\";\r\n                    top.fnSetCookie(\"SELECTEDITEM\",null,-30);\r\n                    if(redirectUrl!=null){\r\n                    parent.middleframe.location.replace(\"EfilingMiddleFrame.html?v=1503272377ta&redirectionRequired=\"+redirectUrl);\r\n                    }else{\r\n                     parent.middleframe.location.replace(\"EfilingMiddleFrame.html?v=1503272377ta\");\r\n                    }\r\n                    break;\r\n                case \"Pref\" :\r\n                    fnnShowDiv();\r\n                    document.getElementById(\"Doc\").className=\"TopMenu\";\r\n                    document.getElementById(\"Pref\").className=\"clsSubMenu\";\r\n                    document.getElementById(\"Admin\").className=\"TopMenu\";\r\n                    parent.middleframe.location.href=\"Preferenceframe.html?v=1503272377ta\";\r\n                    break;\r\n                case \"Admin\" :\r\n                    fnnShowDiv();\r\n                    document.getElementById(\"Doc\").className=\"TopMenu\";\r\n                    document.getElementById(\"Pref\").className=\"TopMenu\";\r\n                    document.getElementById(\"Admin\").className=\"clsSubMenu\";\r\n                    if(userRole.indexOf(gblRoleSep+\"Administrator\"+gblRoleSep) !=-1)\r\n                          parent.middleframe.location.href=\"LoginFrame.html?v=1503272377ta\";\r\n                          //parent.login.location.replace( \"EraseData.html?v=1503272377ta\"\r\n                    else\r\n                        parent.middleframe.location.href=\"LoginFrame.html?v=1503272377ta\";\r\n                    break;\r\n            }\r\n        }\r\n        function fnnShowDiv(){\r\n           //if(top.fnGetCookie(\"USERROLE\").indexOf(gblRoleSep+\"Administrator\"+gblRoleSep) !=-1){\r\n              if(top.fnGetCookie(\"LOGINSTATUS\") ==\"Authenticated\"){\r\n                document.getElementById(\"Login\").style.display=\"none\";\r\n                document.getElementById(\"Logout\").style.display=\"\";\r\n            }else{                \r\n                document.getElementById(\"Login\").style.display=\"\";\r\n                document.getElementById(\"Logout\").style.display=\"none\";\r\n            }\r\n        }\r\n        // Below function is added for Chrome isssue : In chrome onunload function has not been invoked.so with below code we are explicitly calling onbeforeUnload function.\r\n        window.onbeforeunload = function chromeUnload() {\r\n           refreshEfiling();\r\n           return fnGetLocaleString(\"101884\",\"This operation will end Your e-Filing Session.\");\r\n       };\r\n        \r\n    </script>\r\n</head>\r\n\r\n<!--<body bgcolor=\"#C6CFC8\"  onunload='refreshEfiling();'>   -->  <!--  closeAllOpenedWindow();-->\r\n<script>\r\nvar navAppName=navigator.appName;\r\nif((navAppName == \"Netscape\")) /*Check for all netscape family-firefox,safari,netscape etc*/\r\n{\r\n\tvar usrAg = navigator.userAgent; /* stores user agent string*/\r\n\t/*Checking for the string Netscape or Navigator in user agent and retuns the index position*/\r\n\tif((iIndx = navigator.userAgent.indexOf(\"Netscape\")) != -1 || (iIndx = navigator.userAgent.indexOf(\"Navigator\")) !=-1) ;\r\n\tvar netscapeVersion = 0; /*For storing the netscape version*/\r\n\tif(iIndx != -1)\t/*Do this only if netscape*/\r\n\t{\r\n\tusrAg = usrAg.substring(iIndx); /*Get the substring Netscape or Navigator*/\r\n\tiIndx = usrAg.indexOf('/'); /*Get the index of the first / encountered*/\r\n\tusrAg = usrAg.substring((iIndx+1)); /*Get the substring after that / which will contain the version info*/\r\n\tnetscapeVersion = parseFloat(usrAg); /*Get the float number out of the string which is the version of netscape*/\r\n\t}\r\n\tif( netscapeVersion >= 7 || navigator.userAgent.indexOf(\"Firefox\") != -1 ) /*do this for netscape ver >=7 and firefox*/\r\n\t{\r\n\t\tdocument.write(\"<body bgcolor=\\\"#C6CFC8\\\"  onbeforeunload=\\\"refreshEfiling();\\\">\");\r\n\t}else{ /* do this for safari and netscape ver < 7*/\r\n                document.write(\"<body bgcolor=\\\"#C6CFC8\\\" onUnload=\\\"refreshEfiling();\\\">\");\r\n}\r\n}else{ /*do this for IE*/\r\n    if(navAppName.indexOf(\"Microsoft Internet Explorer\")!= -1){\r\n       document.write(\"<body bgcolor=\\\"#C6CFC8\\\"  onbeforeunload=\\\"refreshEfiling();\\\">\"); \r\n    }else{\r\n        document.write(\"<body bgcolor=\\\"#C6CFC8\\\"  onunload=\\\"refreshEfiling();\\\">\");\r\n    }\r\n}\r\n</script>\r\n\r\n <form>\r\n<table cellspacing=0 cellpadding=0 width=\"100%\" height=\"100%\" border=0 height=\"33\" bgcolor=\"#C6CFC8\">\r\n\r\n    <tr width=\"100%\" height=\"100%\">\r\n        <td align=left width=\"23%\"><img src=\"/efiling/images/e-FilingBox_eng.gif\" border=0></td>\r\n        <td align=right width=\"70%\">\r\n            <table border=\"0\" cellpadding=1 cellspacing=0 bgcolor=black align=right>\r\n                <tr>\r\n                    <!--<td height=100% align=\"center\" class=clsSubMenu id=\"jhg\"><input type=\"button\" onclick=\"top.fnSetCookie('EFILINGSESSTIMER','100');\" value=\"forceTimout\"></td>-->\r\n                    <td height=20 align=\"center\" class=clsSubMenu id=\"Doc\">&nbsp;&nbsp;&nbsp;&nbsp;<A href=\"#\" onClick='return fnnTabClick(\"Doc\");' class=header><script type=\"text/javascript\">document.write(fnGetLocaleString(\"100558\",\"Documents\"));</script></A>&nbsp;&nbsp;&nbsp;&nbsp;</td>\r\n                    <td height=20 align=\"center\"  class=TopMenu id=\"Pref\">&nbsp;&nbsp;&nbsp;&nbsp;<A href=\"#\" onClick='return fnnTabClick(\"Pref\");' class=header><script type=\"text/javascript\">document.write(fnGetLocaleString(\"101444\",\"Preferences\"));</script></A>&nbsp;&nbsp;&nbsp;&nbsp;</td>\r\n                    <script type=\"text/javascript\">\r\n                       if(top.fnGetCookie(\"USERROLE\").indexOf(gblRoleSep+\"Administrator\"+gblRoleSep) !=-1)\r\n                              document.write(\"<td height='20' align='center' class=TopMenu id='Admin'>&nbsp;&nbsp;&nbsp;&nbsp;<A href='#' onClick='return fnnTabClick(\\\"Admin\\\");'class=header>\"+fnGetLocaleString(\"100133\",\"Administrator\")+\"</A>&nbsp;&nbsp;&nbsp;&nbsp;</td>\");                             // document.write(\"<td height='20' align='center' class=TopMenu id='Admin'>&nbsp;&nbsp;&nbsp;&nbsp;<A href='#' class=header>Administrator</A></td>\");\r\n                        else\r\n                             document.write(\"<td height='20' align='center' class=TopMenu id='Admin' style='display:none'>&nbsp;&nbsp;&nbsp;&nbsp;<A href='#' onClick='return fnnTabClick(\\\"Admin\\\");' class=header>\"+fnGetLocaleString(\"100133\",\"Administrator\")+\"</A>&nbsp;&nbsp;&nbsp;&nbsp;</td>\");\r\n                     </script>                                                                                                                                                                                      \r\n                </tr>\r\n            </table>\r\n        </td>\r\n        <td width