      <td height=20 width=3></td>\r\n                </tr>\r\n            </table>\r\n        </td>\r\n\r\n        <!--    <script type=\"text/javascript\">\r\n           var status = fnGetCookie(\"LOGINSTATUS\");\r\n            if(status == \"Authenticated\")    \r\n            document.write(\"<td height=20 align=\\\"center\\\" class=clsTopElement nowrap><A href=\\\"#\\\" onClick='return fnnAdminLogout();' class=File1><font color=black><strong>Logout</strong></font></A>&nbsp;&nbsp;&nbsp;</td>\");\r\n        else\r\n            document.write(\"<td height=20 align=\\\"center\\\" class=clsTopElement nowrap><A href=\\\"#\\\" onClick='return fnnTabLoginClick(\\\"Login\\\");' class=File1><font color=black><strong>Login</strong></font></A>&nbsp;&nbsp;&nbsp;</td>\");\r\n      </script>  -->\r\n\r\n\r\n        <!--\r\n        <script>\r\n\r\n            /*var language=navigator.language;\r\n            if(language)\r\n            {\r\n                language=language.substring(0,2);\r\n            }\r\n            else\r\n            {\r\n                language=\"z\";\r\n            }\r\n            switch (language)\r\n            {\r\n                case \"en\" :\r\n                    document.write(\"<td align=left width=\\\"23%\\\"><img src=\\\"/efiling/images/e-FilingBox_eng.gif\\\" border=0></td>\");\r\n                    break;\r\n                case \"ja\" :\r\n                    document.write(\"<td align=left width=\\\"23%\\\"><img src=\\\"/efiling/images/e-FilingBox_jap.gif\\\" border=0></td>\");\r\n                    break;\r\n                default :\r\n                    document.write(\"<td align=left width=\\\"23%\\\"><img src=\\\"/efiling/images/e-FilingBox_eng.gif\\\" border=0></td>\");\r\n            }*/\r\n            var lsLang = 'windows-1252';\r\n            if(lsLang == \"ISO-2022-JP\" || lsLang == \"EUC-JP\" || lsLang == \"Shift-JIS\")\r\n            {\r\n                document.write(\"<td align=left width=\\\"23%\\\"><img src=\\\"/e-