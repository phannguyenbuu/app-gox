sp;&nbsp;\n                            <INPUT TYPE=button NAME=Cancel  size=\"20\" VALUE=\"Cancel\"  onclick=\"fnnCancel()\">&nbsp;&nbsp;-->\n                        </TD>\n                    </TR>\n                    <TR>\n                        <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                        <TD WIDTH=\"25%\" ALIGN=left >&nbsp;</TD>\n                        <TD WIDTH=\"73%\" ALIGN=left>&nbsp;</TD>\n                    </TR>\n\n                </table>\n            </td>\n        </tr>\n    </table>\n</FORM>\n</BODY>\n</HTML>",
