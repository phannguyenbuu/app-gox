-        "title": "e-Filing - Administrator Login",
-        "html": "\n\n<html>\n<head>\n\n\n\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=windows-1252\">\n\n<script language=\"javascript\" type=\"text/javascript\" src=\"/efiling/js/Common.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/efiling/js/Efiling.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/js/AjaxReqRespHandler.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/js/TopAccessUtil.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/js/Authentication.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/js/Validation.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/js/Cookies.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/js/localization.js?v=1503272377ta\"></script>\n\n\n\n<link rel=\"stylesheet\" type=\"text/css\" href=\"styles/Style.css?v=1503272377ta\">\n\n<script language=\"javascript\">\n//if(parent.parent.topframe.fnGetCookie(\"EFILINGLOGINSTATUS\")==\"Authenticated\"){\n\nvar userRole =  top.fnGetCookie(\"USERROLE\");\n  if(userRole.indexOf(gblRoleSep+\"Administrator\"+gblRoleSep) !=-1){\n    parent.parent.topframe.document.getElementById(\"Login\").style.display=\"none\";\n    parent.parent.topframe.document.getElementById(\"Logout\").style.display=\"\";\n    location.replace(\"EraseData.html?v=1503272377ta\");\n}else{\n    parent.parent.topframe.hideDivs(\"Doc~Pref~Admin~Logout~Login\");\n}\nvar lsItemNum;\nvar lsSelItem;\nvar lsINM;\nvar lsDS;\nvar lsPB;\nvar lsParentFol;\nvar lsFirstTime = \"True\";\n\nvar lsAdminData = \"{N}\";\nvar gsType = 'R';\nvar gsErrorMessage = \"test\";\nvar objClass;\nvar gblbtnClicked=false;\n\nvar IsdeptEnable=false;\nvar RequiredDept=\"\";\n\nfunction clsFolder()\n{\n    this.folderName = \"\";\n}\n\n\n/*\nThis function validates the password.\nreturn values:\ntrue: if the string does not contain contain characters from 0 to 9, A to Z or a to z\nfalse: otherwise\n*/\nfunction fnbValidatePassword(lsPassword) {\n\n    objClass = new clsFolder();\n\n    var liCount;\n    var lsCharCode;\n    var liSize = lsPassword.length; // Get the string size\n\n    for(liCount = 0; liCount < liSize; liCount++) {\n\n        lsCharCode = lsPassword.charCodeAt(liCount);\n\n        if (  (lsCharCode < 48 || lsCharCode > 57)\n                && (lsCharCode < 65 || lsCharCode > 90)\n                && (lsCharCode < 97 || lsCharCode > 122) )\n            return true;\n\n        objClass.folderName = objClass.folderName +lsPassword.charAt(liCount);\n\n    }\n\n    return false;\n\n}\n\nfunction fnnSubmitUser(lsBoxNum, lsItemType, lsINM)\n{\n    gblbtnClicked=true;\n    var boxPassword = window.document.forms[0].elements[\"ADMPWD\"].value;\n\n    //if ( (boxPassword.length < 6 || boxPassword.length > 20)  ) {\n    if ( (boxPassword.length == 0)  ) {\n        alert(fnGetLocaleString(\"101398\",\"Please enter valid Password.\"));\n        window.document.forms[0].elements[\"ADMPWD\"].focus();\n        return false;\n    }\n//    setValue(\"Login\",\"Login\");\n    window.document.forms[0].elements[\"Login\"].disabled=true;\n    top.fnSetClientCookie(\"eFilingLogin\",\"true\");\n    showDivs(\"authimg_id\");\n    calledFromPage = \"EfilingAdmin\" ;\n    setAuthenticateParams(\"Admin\", boxPassword);\n\n\n}\n\nfunction fnnFocusOnText()\n{\n    window.document.forms[0].elements[\"ADMPWD\"].focus();\n}\n\nfunction getControlerData(){\n    try {\n        gblGETRequestXMLArray = [\"<Controller><Settings><AdminSystemSettings><Authentication><deptManagement/><NeedDeptInfo/></Authentication></AdminSystemSettings></Settings></Controller>\"];\n        gblBoolHandleRespArray = [true];\n        gblHashMapArray = [null];\n        calledFromPage = \"Login_ControlerData\";\n        InitiateServerRequest(\"GET\");\n    } catch(e){errHandler(e,'getControlerData()','Login.html?v=1503272377ta',\"\");}\n}\n\nfunction fngetStatusControlerData(node) {\n    try {\n            // below variables are need for Password reset and internal Authentication.\n            IsdeptEnable=(((temp =getXpathValue(node,\"Controller/Settings/AdminSystemSettings/Authentication/deptManagement\")) == \"\" || temp == null)?  '' : temp);\n            RequiredDept=(((temp =getXpathValue(node,\"Controller/Settings/AdminSystemSettings/Authentication/NeedDeptInfo\")) == \"\" || temp == null)?  '' : temp);\n\n   } catch(e){errHandler(e,'getStatusControlerData()','Login.html?v=1503272377ta',\"\");}\n}\n\n\nfunction fnnCancel(lsMMT)\n{\n    gblbtnClicked=true;\n    top.giIsContentLoaded = 0;\n    top.giIsMenuLoaded = 0;\n    top.glLoginCancel = \"LoginCanceled\";\n    parent.parent.topframe.showDivs(\"Doc~Pref\");\n    // in order to avoid the refresh of Top Frame : following lines required.\n    parent.parent.topframe.fnnTabClick(\"Doc\");\n\n}\n\nfunction fnnSetCookieFlag()\n{\n    top.fnSetCookie(\"RESET\",\"{Y}\");\n}\n\nfunction fnnContentLoaded()\n{\n    top.giIsContentLoaded = 1;\n}\n\n\n\nfunction fnnClearSession(){\n\n    if(!gblbtnClicked){\n\t\ttop.frames[0].frames[0].frames[0].document.body.setAttribute(\"onunload\",\"\");\n\t\ttop.frames[0].frames[0].document.getElementsByName(\"topframe\")[0].setAttribute(\"src\",\"/Registration/None.html?v=1503272377ta\");\n        top.frames[0].frames[0].document.getElementsByName(\"middleframe\")[0].setAttribute(\"src\",\"/efiling/EflingSessionTimeOut.html?v=1503272377ta\");\n        top.frames[0].frames[0].document.getElementsByName(\"bottomframe\")[0].setAttribute(\"src\",\"/Registration/None.html?v=1503272377ta\");\n\n\t}\n\n}\n    \n\n</script>\n\n\n<title>e-Filing - Administrator Login</title>\n\n</head>\n\n<script language=\"javascript\" >\n    function fnKeyUp() {\n        nn=(document.layers)?true:false;\n        ie=(document.all)?true:false;\n        function keyDown(e) {\n            var evt=(e)?e:(window.event)?window.event:null;\n            if(evt){\n                var key=(evt.charCode)?evt.charCode:\n                        ((evt.keyCode)?evt.keyCode:((evt.which)?evt.which:0));\n                if(key == \"13\") {\n                    document.forms[0].ADMPWD.blur();\n                    fnnSubmitUser();\n                }\n            }\n        }\n        document.onkeydown=keyDown;\n        if(nn) document.captureEvents(Event.KEYDOWN);\n    }\n</script>\n\n<BODY color=white onLoad='getControlerData();fnnSetCookieFlag();fnnFocusOnText();' onbeforeunload='fnnClearSession()'>\n\n<form name=\"myform\">\n    <table border=\"0\" width=\"100%\">\n        <tr width=\"100%\">\n            <td width=\"100%\" align=left valign=top height=32><span class=clsTitle1> <script type=\"text/javascript\">document.write(fnGetLocaleString(\"100135\",\"Administrator Login\"));</script>\n    </span></td>\n        </tr>\n    </table>\n \n <span  id = \"error\" style=\"display:none;\">\n<TABLE BORDER='0'>\n    <TR>\n        <td  width=\"50%\" class=\"clsElement\" nowrap>&nbsp; </td>\n        <TD class='clsErrorNoBackGrnd'  nowrap>[ &nbsp;<span id=\"efiling_Login_error_msg\"></span>&nbsp;]</TD>\n    </TR>\n</TABLE>\n</span>\n\n    <table border=\"0\" width=\"50%\">\n        <tr width=\"50%\">\n            <td  class=\"clsElement\" nowrap><script type=\"text/javascript\">document.write(fnGetLocaleString(\"101345\",\"Password\"));</script></td>\n            <td>\n                <input type=password name=\"ADMPWD\" size=13 maxlength=\"65\" onkeydown=\"fnKeyUp()\" >\n            </td>\n        </tr>\n    </table>\n    <br>\n    <hr size=1>\n    <div align=\"left\" scrollleft=0>\n        <table class=NewWindow border=\"0\">\n            <tr>\n                <td  align=left>&nbsp;<span id=\"authimg_id\" style=\"display:none\"><img src=\"/Graphics/indicator.white.gif\" ></span></td>\n                <!--<script type=\"text/javascript\">document.write(\"<input type=button value=\\\"\"+fnGetLocaleString(\"101290\", \"Login\")+\"\\\" onfocus='lsTest=1' onblur='lsTest=0' onClick=\\\"fnnSaveChanges()\\\">\")-->\n                <script type=\"text/javascript\">document.write(\"<td  align=left class='NewWindow'><INPUT type=button name='Login' value=\\\"\"+fnGetLocaleString(\"101083\", \"Login\")+\"\\\"onfocus='lsTest=1' onblur='lsTest=0' onClick=\\\"fnnSubmitUser()\\\";return false</td>\");</script>\n                <script type=\"text/javascript\">document.write(\"<td  align=left class='NewWindow'><INPUT type=button name='Cancel' value=\\\"\"+fnGetLocaleString(\"100289\", \"Cancel\")+\"\\\"onfocus='lsTest=1' onblur='lsTest=0' onClick=\\\"fnnCancel('Doc')\\\";return false</td>\");</script>\n            </tr>\n        </table>\n    </div>\n</form>\n\n</BODY>\n</HTML>\n\n",
