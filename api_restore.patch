-        "html": "<HTML>\n<HEAD>\n    <META CONTENT=\"text/html; charset=windows-1252\" HTTP-EQUIV=\"Content-Type\" >\n    <LINK REL=\"stylesheet\"  title=\"DEFAULT\" TYPE=\"text/css\" HREF=\"styles/style.css?v=1503272377ta\" >\n    <SCRIPT SRC=\"/js/Cookies.js?v=1503272377ta\"></SCRIPT>\n    <SCRIPT SRC=\"/js/TopAccessUtil.js?v=1503272377ta\"></SCRIPT>\n    <SCRIPT SRC=\"/js/localization.js?v=1503272377ta\"></SCRIPT>\n    <script language=\"javascript\" type=\"text/javascript\" src=\"/js/AjaxReqRespHandler.js?v=1503272377ta\"></script>\n    <SCRIPT Language = \"Javascript\">\n    var iScrnW = screen.width;//width of the screen\n    var iScrnH\t= screen.height;//height of the screen\n    var oAgentSetWin1 = null;\n    var oAgentSetWin2 = null;\n\tvar loginMode=top.fnGetCookie(\"LOGINMODE\");\n\tvar hddInst = \"\";\n\tvar gblDeviceModelIdInFooter = \"\";\n    function fnOpenNewWindow(oAgentSetWin,pFile, pWinName, pWinFeatures, pWinWidth, pWindHeight) {\n        var iWinW = pWinWidth;//window width\n        var iWinH = pWindHeight;//window height\n\n        var iXCoord = (iScrnW - iWinW) / 2;//new window X coordinate\n        var iYCoord = (iScrnH - iWinH) / 2;//new window Y coordinate\n        if((oAgentSetWin != null) && (oAgentSetWin.closed == false)) {\n            //oAgentSetWin.location = pFile;\n            oAgentSetWin.focus();\n        }\n        else // if the window was not created then only create and display a new window in the middle of the screen.\n            oAgentSetWin = window.open(pFile,pWinName,pWinFeatures + \",left=\" + iXCoord + \",top=\" + iYCoord);\n\n        return oAgentSetWin;\n    }\n\tfunction fnnCloseChildWindows() {\n        if((oAgentSetWin1 != null) && (oAgentSetWin1.closed == false) )\n            oAgentSetWin1.close();\n        if((oAgentSetWin2 != null) && (oAgentSetWin2.closed == false) )\n            oAgentSetWin2.close();\n\t}\n    function fnnTopLinkClick()\n    {\n        if(parent.parent.frames[0].frames[0].name != \"Loginframe\") {\n            var frameObj = parent.parent.frames[0].frames[2];\n            if (frameObj.frames[1] != undefined && frameObj.frames[1].location.href.indexOf(\"Network.html?v=1503272377ta\") !=-1)\n            {\n                frameObj.frames[1].document.getElementById(\"go-to-top\").click();\n            }\n            else if(frameObj.length==0 || frameObj.location.href.indexOf(\"userconfirm/Export.html?v=1503272377ta\") !=-1 || frameObj.location.href.indexOf(\"userconfirm/Import.html?v=1503272377ta\") !=-1)// if contents frame has no sub frames\n            {\n                frameObj.scroll(0,0);// scroll up the contents frame to 0,0\n            }\n            else if(frameObj.length==2)// contents frame has 2 sub frames\n            {\n                parent.parent.frames[0].frames[2][1].scroll(0,0);// scroll up the list frame of the contents frame to 0,0\n            }\n            try{\n                if(frameObj.length==1)// contents frame has 1 sub frames\n                {\n                    frameObj.scroll(0,0);// scroll up the list frame of the contents frame to 0,0\n                }\n            }catch(e){}\n        }\n    }\n\n    function fnnInstallSoftwareClick()\n    {\n        oAgentSetWin1 = fnOpenNewWindow(oAgentSetWin1,\"/ClientUpdate/InstallDefault.html?v=1503272377ta\", \"_INST_SW\", \"toolbar=no,height=540,width=760,resizable=yes,scrollbars=yes\", 760, 550);\n\n    }\n    function fnnHelpClick(){\n        glbContentWebServerCmdArray = [\"<GetInstalledLanguages><commandNode>PresentationResources</commandNode><Params><domNodeAddress>PresentationResources</domNodeAddress><type>WebHelp</type></Params></GetInstalledLanguages>\"];\n        gblGETRequestXMLArray = [\"<PresentationResources/>\"];\n        gblBoolHandleRespArray = [true];\n        gblHashMapArray = [null];\n        calledFromPage = \"InstalledWebHelpLanguages\";\n        InitiateServerRequest(\"CMDGET\");\n    }\n    function fnHandleInstalledWebHelpLanguages(node){\n        if(node == null){\n            alert(fnGetLocaleString(\"103472\",\"Internal Error has occurred. Please try again.\"));\n            return;\n        }\n\n        var taTopObj = fnReturnApplnTopObject();\n        var helpFilePath = taTopObj.gblTALocaleDirectory;\n        var langFound = false;\n        var lngLocaleObj = node.getElementsByTagName(\"Language\");\n        var localeVal = \"\";\n        for(var i=0;i<lngLocaleObj.length;i++){\n            localeVal = ((temp=getXpathValue(lngLocaleObj[i],\"locale\"))==null || temp == \"\")?\"\": temp;\n            if(localeVal == helpFilePath){\n                langFound = true;\n                break;\n            }\n        }\n        if(langFound == false){\n            helpFilePath = \"en_US\";\n        }\n        oAgentSetWin2 = fnOpenNewWindow(oAgentSetWin2,\"/Help/\"+helpFilePath+\"/TopAccess/TopAccess.htm\", \"_HELP\", \"toolbar=no,height=600,width=800,resizable=yes,scrollbars=yes\", 800, 600);\n    }\n    function fnGetHDDStatus(){\n        gblGETRequestXMLArray = [\"<MFP><System><HDD><Installation/></HDD></System></MFP>\"];\n        gblBoolHandleRespArray = [true];\n        gblHashMapArray = [null];\n        calledFromPage = \"InstalledHDDStatus\";\n        InitiateServerRequest(\"GET\");\n    }\n    function fnHandleHDDStatus(node){\n        hddInst = \"NotInstalled\";\n        hddInst = ((temp=getXpathValue(node,\"MFP/System/HDD/Installation\"))==null?\"NotInstalled\":temp);\n        if(hddInst==\"Installed\") { // Checking for HDD installation.\n            if (((loginMode==\"SECURED\" && fnGetClientCookie(\"pageTrack\").split('=')[1] != \"LOGIN\") || loginMode==\"NORMAL\")) {\n              showDivs(\"install_id\");\n            }else{\n                hideDivs(\"install_id\");\n           }\n        }\n    }\n    function fnOnLoad(){\n\t\tgblGETRequestXMLArray = [\"<Controller><Information><deviceName/></Information></Controller>\"];\n        gblBoolHandleRespArray = [true];\n        gblHashMapArray = [null];\n        calledFromPage = \"GetDeviceInfoInFooter\";\n\t\tInitiateServerRequest(\"GET\");\n\t\t\n    }\n\t\n\t//added for gettign device id in footer\n\tfunction fnGetDeviceIdInFooter(node){\n\t\tvar deviceModelType= ((temp=getXpathValue(node, \"Controller/Information/deviceName\"))==null?\"\":temp);\n        gblDeviceModelIdInFooter = mfpModelTypeName(deviceModelType);\n\t\tvar elem = document.getElementById(\"InstallSoftwareTableId\");\n\t\tif(gblDeviceModelIdInFooter ==\"WEISS-L\"|| gblDeviceModelIdInFooter ==\"WEISS-LL\" || gblDeviceModelIdInFooter ==\"WEISS-H\" || gblDeviceModelIdInFooter ==\"STHELENS\" || gblDeviceModelIdInFooter ==\"MOSEL\" || gblDeviceModelIdInFooter ==\"CASPIAN\"){\n\t\t\t\telem.innerHTML = '<div class=\"clsDispInstSoft\"><span id=\"install_id\" style=\"display:none\">&nbsp;|&nbsp;&nbsp;<A class=clsFooter href=\"javascript:fnnInstallSoftwareClick()\"> '+fnGetLocaleString(\"100936\",\"Install Software\")+'</A>&nbsp;&nbsp;|</span></div>';\n\t\t}\t\n\t\telse if(gblDeviceModelIdInFooter ==\"LOIRE\"|| gblDeviceModelIdInFooter ==\"ALABAMA\" || gblDeviceModelIdInFooter ==\"MASH\" || gblDeviceModelIdInFooter ==\"BP\"){\n\t\t\tvar loginMode=top.fnGetCookie(\"LOGINMODE\");\n\t\t\tvar EFIcookieValue=top.fnGetCookie(\"EFICtrlInstalled\");\n            if(EFIcookieValue == \"0\" || EFIcookieValue == 0) {\n                if ((loginMode==\"SECURED\" && fnGetClientCookie(\"pageTrack\").split('=')[1] != \"LOGIN\") || loginMode==\"NORMAL\") {\n\t\t\t\t\t\telem.innerHTML = '&nbsp;|&nbsp;&nbsp;<A class=clsFooter href=\"javascript:fnnInstallSoftwareClick()\"><span id=\"WebUI_Install_Software\">'+fnGetLocaleString(\"100936\",\"Install Software\")+'</span></A>&nbsp;&nbsp;|';\n                } else {\n\t\t\t\t\t\telem.innerHTML = '<span id=\"install_id\" style=\"display:none\">&nbsp;|&nbsp;&nbsp;<A class=clsFooter href=\"javascript:fnnInstallSoftwareClick()\"><span id=\"WebUI_Install_Software\">'+fnGetLocaleString(\"100936\",\"Install Software\")+'</span></A>&nbsp;&nbsp;|</span>';\n                }\n            }\n\t\t}\n\t\tif(gblDeviceModelIdInFooter ==\"WEISS-L\"|| gblDeviceModelIdInFooter ==\"WEISS-LL\" || gblDeviceModelIdInFooter ==\"WEISS-H\" || gblDeviceModelIdInFooter ==\"STHELENS\" || gblDeviceModelIdInFooter ==\"MOSEL\" || gblDeviceModelIdInFooter ==\"CASPIAN\")\n\t\t{\n\t\t\tfnGetHDDStatus();\n\t\t}\n\t}\n            </script>\n</HEAD>\n<BODY  TOPMARGIN=\"0\" MARGINWIDTH=\"0\" MARGINHEIGHT=\"0\" LEFTMARGIN=\"0\" onload=\"fnOnLoad()\" onunload=\"fnnCloseChildWindows()\">\n<TABLE BORDER=\"0\" BGCOLOR=\"#6699cc\" CELLPADDING=\"0\" CELLSPACING=\"0\" HEIGHT=\"18\" WIDTH=\"100%\">\n    <TR CLASS=\"clsFooter\" HEIGHT=\"10\">\n        <TD CLASS=\"clsFooter2\" width = \"25%\" NOWRAP id=\"InstallSoftwareTableId\">\n        </TD>\n        <TD NOWRAP>\n        <TD CLASS=\"clsFooter1\" width = \"25%\"  NOWRAP>|&nbsp;&nbsp;<A class=clsFooter href=\"javascript:fnnTopLinkClick();\"><span id=\"WebUI_Top\">\n        <script type=\"text/javascript\">document.write(fnGetLocaleString(\"101913\",\"Top\"));</script>\n        </span></A>&nbsp;&nbsp;|</TD>\n        <TD CLASS=\"clsFooter2\" width = \"25%\"  NOWRAP>&nbsp;&nbsp;<A CLASS=\"clsFooter\" HREF=\"javascript:fnnHelpClick();\"><span id=\"WebUI_Help\">\n            <script type=\"text/javascript\">document.write(fnGetLocaleString(\"100877\",\"Help\"));</script>\n        </span> </A>&nbsp;&nbsp;|</TD>\n\n        <TD class=\"clsFooter\"  align=\"right\" valign=\"middle\" width=\"25%\">\n            <table id=\"copyRight\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                    <TD CLASS=\"clsCopyRight\" >\n                        <IMG src=\"Graphics/copy.gif\" BORDER=0>\n                    </TD>\n                    <TD CLASS=\"clsCopyRight\"   NOWRAP>\n                        <span id=\"WebUI_2003Minus2008_TOSHIBA_TEC_Reserved\"><script type=\"text/javascript\">document.write(fnGetLocaleString(\"100033\",\"2010 TOSHIBA TEC CORPORATION All Rights Reserved.\"));</script></span>\n                    </TD>\n                </tr>\n            </table>\n        </TD>\n\n    </TR>\n</TABLE>\n</BODY>\n</HTML>\n\n \n",
