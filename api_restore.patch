rnW - iWinW) / 2;//new window X coordinate\r\n            var iYCoord = (iScrnH - iWinH) / 2;//new window Y coordinate\r\n            if((oAgentSetWin != null) && (oAgentSetWin.closed == false)) {\r\n                //oAgentSetWin.location = pFile;\r\n                oAgentSetWin.focus();\r\n            }\r\n            else // if the window was not created then only create and display a new window in the middle of the screen.\r\n                oAgentSetWin = window.open(pFile,pWinName,pWinFeatures + \",left=\" + iXCoord + \",top=\" + iYCoord);\r\n\r\n            return oAgentSetWin;\r\n        }\r\n        function fnnCloseChildWindows() {\r\n            if((oAgentSetWin1 != null) && (oAgentSetWin1.closed == false) )\r\n                oAgentSetWin1.close();\r\n            if((oAgentSetWin2 != null) && (oAgentSetWin2.closed == false) )\r\n                oAgentSetWin2.close();\r\n        }\r\n        function fnnHelp() {\r\n            glbContentWebServerCmdArray = [\"<GetInstalledLanguages><commandNode>PresentationResources</commandNode><Params><domNodeAddress>PresentationResources</domNodeAddress><type>WebHelp</type></Params></GetInstalledLanguages>\"];\r\n            gblGETRequestXMLArray = [\"<PresentationResources/>\"];\r\n            gblBoolHandleRespArray = [true];\r\n            gblHashMapArray = [null];\r\n            calledFromPage = \"InstalledWebHelpLanguages\";\r\n            InitiateServerRequest(\"CMDGET\");\r\n            //fnOpenNewWindow(oAgentSetWin2,\"/Help/\"+helpFilePath+\"/e-Filing/e-Filing.htm\", \"_HELP\", \"toolbar=no,height=600,width=800,resizable=yes,scrollbars=yes\", 800, 600);\r\n        }\r\n        function fnHandleInstalledWebHelpLanguages(node){\r\n            if(node == null){\r\n                alert(fnGetLocaleString(\"103472\",\"Internal Error has occurred. Please try again.\"));\r\n                return;\r\n            }\r\n            var taTopObj = fnReturnApplnTopObject();\r\n            var helpFilePath = taTopObj.gblTALocaleDirectory;\r\n            var langFound = false;\r\n            var lngLocaleObj = node.getElementsByTagName(\"Language\");\r\n            var localeVal = \"\";\r\n            for(var i=0;i<lngLocaleObj.length;i++){\r\n                localeVal = ((temp=getXpathValue(lngLocaleObj[i],\"locale\"))==null || temp == \"\")?\"\": temp;\r\n                if(localeVal == helpFilePath){\r\n                    langFound = true;\r\n                    break;\r\n                }\r\n            }\r\n            if(langFound == false){\r\n                helpFilePath = \"en_US\";\r\n            }\r\n            oAgentSetWin2 = fnOpenNewWindow(oAgentSetWin2,\"/Help/\"+helpFilePath+\"/e-Filing/e-Filing.htm\", \"_HELP\", \"toolbar=no,height=600,width=800,resizable=yes,scrollbars=yes\", 800, 600);\r\n        }\r\n        function fnnTop() {\r\n           /*\r\n              // For Future reference/use :\r\n                    parent.parent.frames[0].frames[0].name topframe\r\n\r\n                    parent.parent.frames[0].frames[1].name middleframe\r\n\r\n                    parent.parent.frames[0].frames[1].frames[0].name explorer\r\n\r\n                    parent.parent.frames[0].frames[1].frames[1].name content\r\n\r\n                    when Print doc Page\r\n                    =====================================================\r\n                    parent.parent.frames[0].frames[1].frames[0].name printMidMenu\r\n\r\n                    parent.parent.frames[0].frames[1].frames[1].name printscr\r\n\r\n                    when Send Email Page\r\n                    ====================================================\r\n\r\n                    parent.parent.frames[0].frames[1].frames[0].name fraAgentFrame\r\n\r\n                    parent.parent.frames[0].frames[1].frames[1].name EmailSetup\r\n\r\n                    when Admin login Page\r\n                    ====================================================\r\n                    parent.parent.frames[0].frames[1].frames[1].name login\r\n          */\r\n\r\n            if(parent.parent.frames[0].frames[1].frames[1].name==\"content\"){\r\n                parent.parent.frames[0].frames[1].frames[0].scroll(0,0);           // for explorer part.\r\n                parent.parent.frames[0].frames[1].frames[1].frames[1].scroll(0,0);   // for View part\r\n            }else if(parent.parent.frames[0].frames[1].frames[1].name ==\"printscr\"){\r\n                parent.parent.frames[0].frames[1].frames[1].scroll(0,0);\r\n            }else if(parent.parent.frames[0].frames[1].frames[1].name ==\"EmailSetup\"){\r\n                parent.parent.frames[0].frames[1].frames[1].scroll(0,0);\r\n            } else if(parent.parent.frames[0].frames[1].frames[1].name ==\"login\"){\r\n                parent.parent.frames[0].frames[1].frames[1].scroll(0,0);\r\n            }\r\n        }\r\n        function fnOnload(){\r\n            if(top.fnTrackCookie(\"DiagnosticMode\",\"GET\",\"9003\") == \"1\")\r\n                hideDivs(\"ID_copyRight\")\r\n            else\r\n                showDivs(\"ID_copyRight\")\r\n        }\r\n    </script>\r\n</head>\r\n<body onload=\"fnOnload()\" onunload=\"fnnCloseChildWindows()\">\r\n<table border=\"1\" cellPadding=\"0\" cellSpacing=\"0\" width=\"100%\" height=20 rules=none bordercolor=Black>\r\n    <tr>\r\n        <!--<td class=\"clsFooterLogo\" align=\"left\" width=\"25%\" valign=\"middle\" nowrap><img SRC=\"/efiling/images/toshibalogo.gif\" border=\"0\"></td>-->\r\n        <td class=\"clsFooter\" align=\"right\" width=\"45%\" valign=\"middle\" nowrap><a href=\"#\" onclick='fnnTop();' class=header><script type=\"text/javascript\" language=\"javascript1.5\">document.write(fnGetLocaleString(\"101913\",\"Top\"));</script></a> | <a href=\"#\" onclick='fnnHelp();' class=header><script type=\"text/javascript\" language=\"javascript1.5\">document.write(fnGetLocaleString(\"100877\",\"Help\"));</script></a></td>\r\n        <td class=\"clsFooter\" align=\"right\" valign=\"middle\" width=\"50%\">\r\n            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n                <tr id=\"ID_copyRight\" style=\"display: none;\">\r\n                    <td class=\"clsCopyRight\" nowrap align=right><img src=\"images/copyright.gif\" border=0></td>\r\n                    <td class=\"clsCopyRight\" nowrap align=left> <script type=\"text/javascript\" language=\"javascript1.5\">document.write(fnGetLocaleString(\"100033\",\"2010 TOSHIBA TEC CORPORATION All Rights Reserved.\"));</script></td>  \r\n                </tr>\r\n            </table>\r\n        </td>\r\n    </tr>\r\n</table>\r\n<form>\r\n    <input type=hidden name=HeadTab value=\"\">\r\n</form>\r\n</body>\r\n</html>\r\n\r\n",
