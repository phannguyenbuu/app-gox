-        "html": "<!doctype html public \"-//W3C//DTD HTML 3.2 Final//EN\">\n<HTML>\n<HEAD>\n<META HTTP-EQUIV=\"Content-Type\" CONTENT=\"text/html; CHARSET=windows-1252\">\n<LINK REL=\"stylesheet\" TYPE=\"text/css\" HREF=\"/styles/style.css?v=1503272377ta\">\n\n<SCRIPT language=\"javascript\" type=\"text/javascript\" src=\"/js/Validation.js?v=1503272377ta\"></SCRIPT>\n<SCRIPT language=\"javascript\" type=\"text/javascript\" src=\"/js/TopAccessUtil.js?v=1503272377ta\"></SCRIPT>\n<SCRIPT language=\"javascript\" type=\"text/javascript\" src=\"/js/Cookies.js?v=1503272377ta\"></SCRIPT>\n<SCRIPT language=\"javascript\" type=\"text/javascript\" src=\"/js/Authentication.js?v=1503272377ta\"></SCRIPT>\n<SCRIPT language=\"javascript\" type=\"text/javascript\" src=\"/js/AjaxReqRespHandler.js?v=1503272377ta\"></SCRIPT>\n<SCRIPT language=\"javascript\" type=\"text/javascript\" src=\"/js/WindowOperations.js?v=1503272377ta\"></SCRIPT>\n\n<SCRIPT LANGUAGE=\"javascript\">\nfunction fnnOnload(){\n    window.document.frmFirstLogin.elements[\"PASSWORD\"].focus();\n    var roles= top.fnGetCookie(\"USERROLE\");\n    if(roles.indexOf(gblRoleSep+\"Administrator\"+gblRoleSep) !=-1) {\n        roles = \"Administrator\";\n    }\n    if(roles == \"Administrator\"){\n        document.getElementById(\"SecretQ\").style.display=\"\";\n        document.getElementById(\"SecretA\").style.display=\"\";\n    } else {\n        document.getElementById(\"SecretQ\").style.display=\"none\";\n        document.getElementById(\"SecretA\").style.display=\"none\";\n    }\n}\n\nfunction fnnSave() {\n\tvar objfrm=document.frmFirstLogin;\n    var objPassWord = objfrm.PASSWORD;\n    var objconfirmPassword= objfrm.PASSWORDCONFIRM;\n    var objEmail= objfrm.EMAILADDR;\n\n    var newPassword = objPassWord.value;\n    var rPassword = objconfirmPassword.value;\n    var email =  objEmail.value;\n\n    var newPasswd = fnsTrim(newPassword);\n    var repeatedPasswd =fnsTrim(rPassword);\n    var emailid = fnsTrim(email);\n    var nSize = newPasswd.length;\n    var rSize = repeatedPasswd.length;\n    var roles= top.fnGetCookie(\"USERROLE\");\n    if(roles.indexOf(gblRoleSep+\"Administrator\"+gblRoleSep) !=-1) {\n        roles = \"Administrator\";\n    }    \n    /*if ( (nSize < 6 || nSize >60)) {    //|| fnbValidatePassword(newPasswd)\n        alert(\"Please enter a valid value.(New Password)\");\n        objPassWord.value = \"\";\n        objPassWord.focus();\n        return false;\n    }\n\n    else if ( (rSize < 6 || rSize > 60)) {\n        alert(\"Please enter a valid value.(Retype Password)\");\n        objconfirmPassword.value = \"\";\n        objconfirmPassword.focus();\n        return false;\n    }\n    else if((!fnnValidatePassword(newPasswd)) || (!fnnValidatePassword(rPassword)) ){\n        objfrm.PASSWORD.value=\"\";\n        objfrm.PASSWORDCONFIRM.value=\"\";\n        objfrm.EMAILADDR.value=\"\";\n        objfrm.PASSWORD.focus();\n        return false\n    }*/\n\n\n    if (newPasswd != repeatedPasswd ) {\n        //alert(\"The password you entered does not match. Please enter new password again.\");\n        showDivs(\"error\");\n        objfrm.PASSWORD.value=\"\";\n        objfrm.PASSWORDCONFIRM.value=\"\";\n        objfrm.PASSWORD.focus();\n        return false;\n    }\n    hideDivs(\"error\");\n    var isAdmin = false;\n    var securityQuestion = \"\";\n    var securityAns = \"\";\n    if (roles  == \"Administrator\") {\n        isAdmin = true;\n        securityQuestion =  objfrm.SECQUEST.value;\n        securityAns = objfrm.SECANSWER.value;\n        if(securityQuestion == \"\") {\n            alert(\"Please enter a valid Secret Question.\");\n            objfrm.SECQUEST.value =\"\";\n            objfrm.SECQUEST.focus();\n            return false;\n        }\n        if(securityAns == \"\") {\n            alert(\"Please enter a valid Secret Answer\");\n            objfrm.SECANSWER.value =\"\";\n            objfrm.SECANSWER.focus();\n            return false;\n        }\n\n    }\n    if(emailid == \"\") {\n        alert(\"Please enter an Email Address\");\n        objfrm.EMAILADDR.value =\"\";\n        objfrm.EMAILADDR.focus();\n        return false;\n    } else if(!fnnValidateEmailId(objEmail)) {\n        objfrm.EMAILADDR.focus();\n        return false;\n    }\n    var lbresult;\n    lbresult=confirm(\"Are you sure you want to change the password?\");\n    if(lbresult == true) {\n        setValue(\"Enter\",\"Updating...\");\n        showDivs(\"authimg_id\");\n        window.document.frmFirstLogin.elements[\"Enter\"].disabled=true;\n        //var tokenId = top.fnGetCookie(\"SESSID\");\n        if(isAdmin)  {\n            //updateUserInfoForAdmin(tokenId, emailid,  newPasswd, repeatedPasswd, roles, securityQuestion, securityAns );\n            updateUserAfterPasswordResetForAdmin(emailid,  newPasswd, repeatedPasswd, securityQuestion, securityAns,getValue(\"CopierLanguage\"));\n        } else {\n            //updateUserInfo(tokenId, emailid , newPasswd, repeatedPasswd, roles );\n            updateUserAfterPasswordReset(emailid , newPasswd, repeatedPasswd,getValue(\"CopierLanguage\"));\n        }\n    }\n    else{\n        objfrm.PASSWORD.value=\"\";\n        objfrm.EMAILADDR.value=\"\";\n        objfrm.PASSWORDCONFIRM.value=\"\";\n        if(isAdmin)  {\n            objfrm.SECQUEST.value =\"\";\n            objfrm.SECANSWER.value =\"\";\n        }\n        objfrm.PASSWORD.focus();\n        setValue(\"Enter\",\"Enter\");\n        window.document.frmFirstLogin.elements[\"Enter\"].disabled=false;\n        return;\n    }\n}\nfunction fnnCancel() {\n    top.fnSetCookie(\"SESSID\", null, -30 );\n    top.fnSetCookie(\"LOGINSTATUS\",null, -30);\n    top.fnSetCookie(\"USERROLE\",null, -30);\n    calledFromPage = \"LogoutUser\";\n    unAuthenticateUser();\n    top.location.replace(window.location.protocol+\"//\"+((window.location.hostname.indexOf(\":\") != -1 && window.location.hostname.indexOf(\"]\") == -1)?((\"[\"+window.location.hostname+\"]\")+((window.location.port != \"\")? \":\"+window.location.port : \"\" )) : window.location.host));\n}\n\n</SCRIPT>\n</HEAD>\n<BODY bgColor=\"#ffffe0\" ONLOAD=\"fnnOnload();\">\n\n<FORM NAME=\"frmFirstLogin\">\n    <table id=\"tblTitle\" width=\"100%\"  height=33px cellSpacing=0 cellPadding=0   border=0 >\n        <TR HEIGHT=\"100%\" WIDTH=\"100%\" BGCOLOR=\"#ffffe0\">\n            <TD WIDTH=\"100%\" CLASS=\"clsTopAccessLogo\" NOWRAP>&nbsp;&nbsp;&nbsp;</TD>\n        </TR>\n    </table>\n    <br>\n    <br>\n    <table border=\"0\" width=100%>\n        <tr>\n            <td>&nbsp;&nbsp;&nbsp;&nbsp;</td>\n            <td>\n                <table border=\"1\" bordercolor=#5E88F7 cellspacing=0>\n                    <tr>\n                        <td>\n                            <table  bgcolor=\"#EDEFF1\"   border=0 width=550>\n                                <TR>\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left>&nbsp;</TD>\n                                </TR>\n                                <TR>\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD  WIDTH=\"98%\" ALIGN=left colspan=\"2\"  class=clsSecurityTDNoBorder ><span id=\"WebUI_Enter_the_following_informcreation\">Create a new password and enter your e-mail address to complete account creation.</span></TD>\n                                </TR>\n                                <TR>\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left>&nbsp;</TD>\n                                </TR>\n                                <TR>\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left class=clsSecurityTDNoBorder><span id=\"WebUI_Password\">Password</span>:&nbsp; </TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left>\n                                        <INPUT TYPE=password SIZE=52 NAME=\"PASSWORD\" VALUE=\"\">\n                                    </TD>\n                                </TR>\n                                <TR>\n                                    <TD WIDTH=\"2%\" ALIGN=left ></TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left class=clsSecurityTDNoBorder><span id=\"WebUI_Confirm_Password\">Confirm Password</span>:&nbsp; </TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left><INPUT TYPE=password SIZE=52 NAME=\"PASSWORDCONFIRM\"></TD>\n                                </TR>\n                                <TR>\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left class=clsSecurityTDNoBorder><span id=\"WebUI_Email_Address\">E-mail Address</span>:&nbsp; </TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left>\n                                        <INPUT TYPE=text SIZE=52 NAME=\"EMAILADDR\" VALUE=\"\">\n                                    </TD>\n                                </TR>\n                                <TR id=\"SecretQ\">\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left class=clsSecurityTDNoBorder><span id=\"WebUI_Secret_Question\">Secret Question</span>:&nbsp; </TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left>\n                                        <INPUT TYPE=text SIZE=52 NAME=\"SECQUEST\" VALUE=\"\">\n                                    </TD>\n                                </TR>\n                                <TR id=\"SecretA\">\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left class=clsSecurityTDNoBorder><span id=\"WebUI_Secret_Answer\">Secret Answer</span>:&nbsp; </TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left>\n                                        <INPUT TYPE=text SIZE=52 NAME=\"SECANSWER\" VALUE=\"\">\n                                    </TD>\n                                </TR>\n                                <TR>\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left class=clsSecurityTDNoBorder><span id=\"WebUI_Copier_Language\">Copier Language </span>:&nbsp; </TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left>\n                                        <SELECT size=1 style=\"width:50%;height:100%;\" size=\"1\"  name=CopierLanguage>\n                                            <OPTION value=\"en\" >English</OPTION>\n                                            <OPTION value=\"jp\">Japanese </OPTION>\n                                            <OPTION value=\"fr\">French</OPTION>\n                                        </SELECT>\n                                    </TD>\n                                </TR>\n                                 <TR id = \"error\" style=\"display:none;\">\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left class=\"clsErrorNoBackGrnd\"><nobr><span id=\"WebUI_the_Password_and_Confirm_Pot_match\">The Password and Confirm Password fields do not match.</span></nobr></TD></TR>\n                                <TR>\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left>&nbsp;</TD>\n                                </TR>\n                                <TR>\n\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"73%\" align=\"center\">\n                                        <span id=\"authimg_id\" style=\"display:none\"><img src=\"/Graphics/indicator.white.gif\" ></span>\n                                        <INPUT TYPE=button NAME=Enter   size=\"20\" VALUE=\"Enter\"  onclick=\"fnnSave()\">&nbsp;&nbsp;\n                                        <INPUT TYPE=button NAME=Cancel  size=\"20\" VALUE=\"Cancel\"  onclick=\"fnnCancel()\">&nbsp;&nbsp;\n                                    </TD>\n                                </TR>\n                                <TR>\n                                    <TD WIDTH=\"2%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"25%\" ALIGN=left >&nbsp;</TD>\n                                    <TD WIDTH=\"73%\" ALIGN=left>&nbsp;</TD>\n                                </TR>\n\n                            </table>\n                        </td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n</FORM>\n</BODY>\n</HTML>",
