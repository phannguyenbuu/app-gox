ment.getElementById(\"Doc\").className=\"TopMenu\";\n    parent.parent.topframe.document.getElementById(\"Pref\").className=\"TopMenu\";\n}else{\n    parent.parent.topframe.document.getElementById(\"Logout\").style.display=\"none\";\n    parent.parent.topframe.showDivs(\"Doc~Pref~Admin~Login\");\n    parent.parent.topframe.document.getElementById(\"Admin\").className=\"clsSubMenu\";\n    parent.parent.topframe.document.getElementById(\"Doc\").className=\"TopMenu\";\n    parent.parent.topframe.document.getElementById(\"Pref\").className=\"TopMenu\";\n }\n\n if(status_Msg==\"\"|| status_Msg==\"STATUS_OK\" ){\n    setTimeout(\"fnShowDiv()\",3000);\n }\n\nfunction fnShowDiv(){\n    document.getElementById(\"msg_id\").style.display=\"none\";   \n    document.getElementById(\"boxData_id\").style.display=\"\";\n}\n\nfunction fnnOnLoad() {\n    gaImages[0] = \"/Graphics/checkbutton.gif\";\n    var getData =getQueryStringValue(\"sortValue\",\"self\");\n    if (getData == undefined || getData == \"\") {\n        lsSV=\"undefined\";\n        lsST = \"A\"  ;\n        gaImages[1] = \"/efiling/images/A-U.GIF\";\n    }\n    else {\n        var sortType =getQueryStringValue(\"sortType\",\"self\");\n        lsSV = getData;\n        if(sortType==\"A\"){\n            lsST = \"A\";\n            gaImages[1] = \"/efiling/images/A-U.GIF\";\n        }\n        else if (sortType==\"D\")  {\n            lsST = \"D\";\n            gaImages[1] = \"/efiling/images/A-D.GIF\";\n        }\n    }\n\n    var i,j=gaPreload.length;\n\n    for(i=0; i<gaImages.length; i++)\n    {\n        gaPreload[j] = new Image();\n        gaPreload[j++].src = gaImages[i];\n    }\n}\n\n\nfunction fnnAdminBoxList () {\n    if(status_Msg==\"STATUS_USER_EDITING\"){\n     document.getElementById(\"msg_id\").style.display=\"\";\n     showDivs(\"msg_delete\");\n    } else if(status_Msg==\"\"|| status_Msg==\"STATUS_OK\"){        \n        gblSETRequestXMLArray =[\"<FileStorages><FileStorage selected='1'><name>EFiling</name></FileStorage></FileStorages>\"];\n        glbContentWebServerCmdArray = [\"<GetEFilingBoxes><commandNode>eFiling/BoxList</commandNode><Params><responseXpath contentType='Value'>eFiling/View/BoxList</responseXpath><pageNumber contentType='Value'>1</pageNumber><pageSize contentType='Value'>-1</pageSize></Params></GetEFilingBoxes>\",\"<GetPhysicalSpaceInfo><commandNode>FileStorages</commandNode></GetPhysicalSpaceInfo>\"];\n        gblGETRequestXMLArray = [\"<eFiling><View><BoxList/></View></eFiling>\",\"<FileStorages><FileStorage><name>EFiling</name></FileStorage></FileStorages>\"];\n        gblBoolHandleRespArray = [true];\n        gblHashMapArray = [null];\n        calledFromPage = \"EfilingAdminBoxLists\";\n        InitiateServerRequest(\"SETCMDGET\");\n    }\n}\n\n\nfunction fillAdminBoxList(node) {\n    fnnOnLoad();\n    /*var liTmpSize = Math.round(lsFaxData);\n        if (liTmpSize < (10 * 1024 ))\n            lsFaxData = Math.floor(liTmpSize) + \" KB\";\n        else\n            lsFaxData = Math.floor(liTmpSize/1024) + \" MB\";\n    */\n    var lsBoxData=\"\";\n    var efilingSpaceAvail =  getNodeValue(evaluateXpath(node,\"FileStorages/FileStorage[name='EFiling']/availableSpace\"));\n    if(efilingSpaceAvail == null || efilingSpaceAvail == \"\") {\n        efilingSpaceAvail = 0+\" KB\";\n    }else{\n   // efilingSpaceAvail=fnConvertSize(efilingSpaceAvail);\n    efilingSpaceAvail = Math.round(efilingSpaceAvail);\n    if (efilingSpaceAvail < (10 * 1048576))\n        efilingSpaceAvail = Math.floor(efilingSpaceAvail/1024) + \" KB\";\n    else\n        efilingSpaceAvail =  Math.floor(efilingSpaceAvail/[Math.pow(1024,2)]) +\" MB\";\n    }\n    lsBoxData = getNodeValue(evaluateXpath(node,\"FileStorages/FileStorage[name='EFiling']/usedSpace\"));\n    if(lsBoxData == null || lsBoxData == \"\") {\n        lsBoxData = 0+\" KB\";\n    }else{\n    // lsBoxData=fnConvertSize(lsBoxData);\n    lsBoxData = Math.round(lsBoxData);\n    if (lsBoxData < (10 * 1048576))\n        lsBoxData = Math.floor(lsBoxData/1024) + \" KB\";\n    else\n        lsBoxData =  Math.floor(lsBoxData/[Math.pow(1024,2)]) +\" MB\";\n     }\n    \n    var storageStr=\"\";    \n     if(top.gblStorageType==\"HDD\")\n\t   storageStr=fnGetLocaleString(\"100599\", \"e-Filing Disk Space Available\");\n    else if(top.gblStorageType==\"SSD\")\n        storageStr=fnGetLocaleString(\"104148\", \"e-Filing SSD Space Available\");\n    else if(top.gblStorageType==\"DeviceMemory\")\n        storageStr=fnGetLocaleString(\"104149\", \"e-Filing Device Memory Space Available\");\n        \n    var boxDataHtml=\"<table border=0 width=100%><tr><td class=Folder><span class=eraseBoxPageTitle>&nbsp;\"+fnGetLocaleString(\"102496\", \"Box Management\")+\"</span></td></tr><tr></tr><tr></tr><tr><td width='25%' class=Folder >&nbsp;\"+ storageStr +\" &nbsp;: \" + efilingSpaceAvail + \"&nbsp;</td></tr><tr><input type=\\\"hidden\\\" name=\\\"foldername\\\"><td><table border=1 cellpadding=2 cellspacing=0 style='border: thin none' width='100%'><tbody><tr><td width='25%' class=\\\"clsHeaderTable\\\" >&nbsp;\"+fnGetLocaleString(\"101786\", \"Stored Data\")+\"&nbsp;</td><td width='25%' class=\\\"clsHeaderTable\\\" >&nbsp; \"+fnGetLocaleString(\"100427\", \"Data Type\")+\" &nbsp;</td><td width='25%' class=\\\"clsHeaderTable\\\" >&nbsp;\"+fnGetLocaleString(\"100424\", \"Data Size\")+\" &nbsp;</td><td width='25%' class=\\\"clsHeaderTable\\\" >&nbsp;\"+fnGetLocaleString(\"101560\", \"Remarks\")+\" &nbsp;</td><tr><td width='25%' align=left class=\\\"clsElementTable\\\" nowrap>&nbsp;Box &nbsp;</td><td width='25%' align=center class=\\\"clsElementTable\\\" nowrap> \"+fnGetLocaleString(\"101712\", \"Shared File\")+\"&nbsp;</td><td width='25%' align=center class=\\\"clsElementTable\\\" nowrap>\"+lsBoxData+\"&nbsp;</td><td width='25%' align=left class=Folder nowrap>&nbsp;&nbsp;</td><tr></tr></td></tbody></table></tr></table><br><br><br><br><br>\"  ;    boxDataHtml+=\"<table class=NewWindow border=\\\"0\\\">\";