rmValues.elements[i].type == 'checkbox')\n            {\n                document.frmValues.elements[i].checked = true;\n                if(arrBoxListObj[count][4]  == \"Locked\") {\n                   isLocked = true;\n                }\n                isRowSelected = true;\n            }\n        }\n    }\n    if(document.frmSort.CA.value == 1)   {\n        document.checkdButton.src = \"/Graphics/checkbutton.gif\";\n        document.frmSort.CA.value = 0;\n        document.frmValues.Unlock.disabled = true;\n    }\n    else {\n         if(isRowSelected == true) {\n            document.checkdButton.src = \"/Graphics/checkbuttondown.gif\";\n        }\n        document.frmSort.CA.value = 1;\n        if(isLocked) {\n            document.frmValues.Unlock.disabled = false;\n        }\n    }\n}\nvar lsBoxName =new Array();\nfunction fnbOpenPropertyWindow(lsBoxNum,lsBoxNameIndex,moniker,lock) {\n    var lsLink =\"AdminBoxProperties.html?v=1503272377ta&boxNum=\"+lsBoxNum+\"&boxName=\"+lsBoxName[parseInt(lsBoxNameIndex)]+\"&moniker=\"+moniker+\"&Lock=\"+lock ;\n    window.open(lsLink,\"Property\",\"toolbar=false,location=false,directories=false,status=yes,menubar=false,scrollbars=no,resizable=no,left=230,top=100,width=550,height=600\");\n}\nfunction fnnClearSession(){\n\t// top.glLoginCancel=\"DONOTALERT\";\n    if(top.gblSelectedLink==null){\n        if(!top.gblAdminCall)  {\n            //top.frames[0].frames[0].frames[0].document.body.setAttribute(\"onbeforeunload\",\"\");\n            //top.frames[0].frames[0].document.getElementsByName(\"topframe\")[0].setAttribute(\"src\",\"/Registration/None.html?v=1503272377ta\");\n            top.frames[0].frames[0].document.getElementsByName(\"topframe\")[0].setAttribute(\"src\",\"EfilingTopFrame.html?v=1503272377ta\");\n            top.frames[0].frames[0].document.getElementsByName(\"middleframe\")[0].setAttribute(\"src\",\"/efiling/EfilingMiddleFrame.html?v=1503272377ta\");\n            top.frames[0].frames[0].document.getElementsByName(\"bottomframe\")[0].setAttribute(\"src\",\"Footer.html?v=1503272377ta\");\n            }\n\t\t}\n\t \n}\n\n\n</script>\n</head>\n\n<script>\n/*\n\nvar gaImages ;\ngaImages = new Array();\ngaImages[0] = \"/Graphics/checkbutton.gif\";\n\nvar lsST  =getQueryStringValue(\"sortType\",\"self\");\nalert(\"lsST outside  =\"+lsST)\nif(lsST == 'undefined' || lsST == \"\"|| lsST == undefined)\n    lsST = \"D\";\nif(lsST == \"A\") {\n    gaImages[1] = \"/efiling/images/A-U.GIF\";\n    //lsST = \"D\";\n}\nelse {\n    gaImages[1] = \"/efiling/images/A-D.GIF\";\n    //lsST = \"A\";\n}\ngaPreload = new Array();\nvar i,j=gaPreload.length;\nfor(i=0; i<gaImages.length; i++)\n{\n    gaPreload[j] = new Image();\n    gaPreload[j++].src = gaImages[i];\n}\n*/\n\nfunction enableLockedAccount(){\n    var liSelectedItem;\n    var arrSelectedMoniker=new Array();\n    var count = 0;\n    top.gblSelectedLink=\"Unlock\";\n    for(var i = 0;i < document.frmValues.elements.length;i++) {\n        if(document.frmValues.elements[i].type == 'checkbox') {\n            if(document.frmValues.elements[i].checked) {\n                liSelectedItem = document.forms[0].elements[i].name;\n                liSelectedItem = liSelectedItem.substring(\"Box\".length);\n                for(var j=0;j<arrBoxListObj.length;j++){\n                    if(parseInt(arrBoxListObj[j][0],10)==liSelectedItem){\n                        if(arrBoxListObj[j][4]  == \"Locked\")  {\n                            arrSelectedMoniker[count++]=arrBoxListObj[j][2];\n                        }\n\n                    }\n                }\n\n            }\n        }\n    }\n    calledFromPage=\"AdminBoxDelete\";\n    releaseBoxLockedAccount(arrSelectedMoniker);\n}\nfunction fnnSubmitUser() {\n    var newWindow = null;\n    var liCount = 0;\n    var liSelectedItem = '';\n    var lsBoxNumList = new Array(liCount);\n    var lsBoxId;\n    var k=0;\n    var a=0;\n    var arrSelectedDocs=new Array();\n    var arrSelectedMoniker=new Array();\n    top.gblSelectedLink=\"DeleteBox\";\n\n    for(i=0;i<document.forms[0].elements.length;i++)\n    {\n        if(document.forms[0].elements[i].type == 'checkbox')\n        {\n            if(document.forms[0].elements[i].checked == true)\n            {\n                liCount++;\n\n                liSelectedItem = document.forms[0].elements[i].name;\n                liSelectedItem = liSelectedItem.substring(\"Box\".length);\n                for(var j=0;j<arrBoxListObj.length;j++){\n                    if(parseInt(arrBoxListObj[j][0],10)==liSelectedItem){\n                        arrSelectedDocs[a++]=liSelectedItem;\n                        arrSelectedMoniker[k++]=arrBoxListObj[j][2];\n                        break ;\n                    }\n                }\n               // lsBoxID = \"HBI\"+liSelectedItem;\n                // lsBoxNumList[liCount-1] = document.forms[0].elements[lsBoxID].value;\n                // alert(\"lsBoxNumList[liCount-1] : \"+lsBoxNumList[liCount-1]);\n            }\n        }\n    }\n\n    if(liCount == 0)\n    {\n        alert(fnGetLocaleString(\"101411\",\"Please select at least one item.\"));\n        return false;\n    }\n    else\n    {\n        var res = confirm(fnGetLocaleString(\"100549\", \"Do you want to delete the item(s)?\"));\n        if(!res)\n        {\n            return;\n        }\n        else\n        {\n            calledFromPage=\"AdminBoxDelete\";\n            deleteBox(arrSelectedMoniker,\"AdminDelete\") ;\n        }\n    }//else\n}\n\nfunction Sort(sSV) {\n    top.gblSelectedLink=\"Sort\";\n    if(lsSV == sSV) {\n        if(lsST == \"A\"  ) {\n            location.replace(\"EraseData.html?v=1503272377ta&sortValue=\"+sSV+\"&sortType=D\");\n        }\n        else {\n            location.replace(\"EraseData.html?v=1503272377ta&sortValue=\"+sSV+\"&sortType=A\");\n        }\n    } else {\n        location.replace(\"EraseData.html?v=1503272377ta&sortValue=\"+sSV+\"&sortType=A\");\n    }\n    return false;\n}\n\nfunction sortNumbers(a,b)\n{\n    return (a-b);\n}\n\nfunction fnnContentLoaded()\n{\n    top.giIsContentLoaded = 1;\n    top.gilsADMINMSG= \"\";\n    top.gilsErasePageLoaded=1;\n}\n//funtion used to make that erase page is unloading\nfunction fnnUnLoad()\n{\n    top.gilsErasePageLoaded=0;\n}\n</script>\n<body leftmargin=0 topmargin=0 marginwidth=\"0\" marginheight=\"0\" alink='#00ff00' bgColor='#ffffff' link='#6080c0' text='#000000' vlink='#6080c0'\n      onload='fnnContentLoaded(); fnnAdminBoxList();' onunload='fnnUnLoad()' >   <!-- onbeforeunload='fnnClearSession(); onbeforeunload='fnnClearSession()''-->\n<SPAN class=clsBody>\n<form name=\"frmValues\">\n    <table width=\"100%\">\n        <tr>\n            <td class=\"clsErrorNoBackGrnd\" id=\"msg_id\">\n                <script type=\"text/javascript\">\n                    if(top.gblStorageType==\"HDD\")\n                        document.write(fnGetLocaleString(\"101417\", \"Please Wait.Calculating available Disk Space.Time for Calculation is increased if the job is processing...\"));\n                    else if(top.gblStorageType==\"SSD\")\n                        document.write(fnGetLocaleString(\"104154\",\"Please wait. Calculating available SSD space. Time for calculation is increased if job is processing.\"));\n                    else if(top.gblStorageType==\"DeviceMemory\")\n                        document.write(fnGetLocaleString(\"104155\",\"Please wait. Calculating available Device Memory space. Time for calculation is increased if job is processing.\"));\n                </script>\n            </td>\n        </tr>\n    </table>\n   \n    <table width=\"100%\">\n        <tr>\n            <td class=\"clsErrorNoBackGrnd\" id=\"msg_delete\" style=\"display:none\">\n                <script type=\"text/javascript\">document.write(fnGetLocaleString(\"101827\", \"The Box cannot be erased. A document contained in Box is being used.\"));</script>\n            </td>\n        </tr>\n    </table> \n    <SPAN id=\"boxData_id\" style=\"display:none\"> </SPAN>\n</form>\n</SPAN>\n<FORM NAME=\"frmSort\">\n    <SCRIPT LANGUAGE=\"javascript\">\n        document.write(\"<input type=hidden name=TR value=\\\"\" + giNumOfBoxes + \"\\\">\");\n        document.write(\"<input type=hidden name=CA value=\\\"0\\\">\");\n        document.write(\"<input type=hidden name=TS value=\\\"\" + lsST + \"\\\">\");\n        document.write(\"<input type=hidden name=SV value=\\\"\" + lsSV + \"\\\">\");\n    </SCRIPT>\n    <INPUT TYPE=HIDDEN NAME=OPBX VALUE=\"undefined\">\n    <INPUT TYPE=HIDDEN NAME=ASPPG VALUE=\"\">\n    <input type=hidden name=\"INO\" value=\"\">\n    <input type=hidden name=\"INM\" value=\"\">\n    <input type=hidden name=\"SI\" value=\"R\">\n    <input type=hidden name=\"DS\" value=\"\">\n    <input type=hidden name=\"SID\" value=\"1205421079\">\n    <input type=hidden name=\"PF\" value=\"\">\n    <input type=hidden name=\"PB\" value=\"\">\n\n</FORM>\n\n</body>\n\n</html>\n\n",
