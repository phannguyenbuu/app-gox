-        "html": "\n\n<html>\n<head>\n<title></title>\n\n\n\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=windows-1252\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"styles/Style.css?v=1503272377ta\">\n\n<script language=\"javascript\" type=\"text/javascript\" src=\"/efiling/js/Common.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/efiling/js/MenuView.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/efiling/js/Efiling.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/js/AjaxReqRespHandler.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/js/TopAccessUtil.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/js/Validation.js?v=1503272377ta\"></script>\n<script language=\"javascript\" type=\"text/javascript\" src=\"/js/localization.js?v=1503272377ta\"></script>\n<script language=\"JavaScript\" type=\"text/javascript\">\nvar gaImages ;\ngaImages = new Array();\nvar lsST ;\nvar gaPreload;// = new Array();\ngaPreload = new Array();\nvar boxname = \"\";\nvar moniker = \"\";\nvar usedCapacity = \"\";\nvar usedCapacityObj=\"\";\nvar boxId = \"\"\nvar boxObj = null;\nvar monikerObj = null;\nvar giNumOfBoxes=\"\";\nvar lsBoxData=\"0\";         // harcoded for Box Data.\nvar lsSV = \"\";\nvar lsST\n\nvar status_Msg=getQueryStringValue(\"status\",\"self\");\nvar userRole =  top.fnGetCookie(\"USERROLE\");\n\n\nif(userRole.indexOf(gblRoleSep+\"Administrator\"+gblRoleSep) !=-1) {\n    //if(parent.parent.topframe.fnGetCookie(\"EFILINGLOGINSTATUS\")==\"Authenticated\"){\n    parent.parent.topframe.document.getElementById(\"Login\").style.display=\"none\";\n    parent.parent.topframe.showDivs(\"Doc~Pref~Admin~Logout\");\n    parent.parent.topframe.document.getElementById(\"Admin\").className=\"clsSubMenu\";\n    parent.parent.topframe.document.getElementById(\"Doc\").className=\"TopMenu\";\n    parent.parent.topframe.document.getElementById(\"Pref\").className=\"TopMenu\";\n}else{\n    parent.parent.topframe.document.getElementById(\"Logout\").style.display=\"none\";\n    parent.parent.topframe.showDivs(\"Doc~Pref~Admin~Login\");\n    parent.parent.topframe.document.getElementById(\"Admin\").className=\"clsSubMenu\";\n    parent.parent.topframe.document.getElementById(\"Doc\").className=\"TopMenu\";\n    parent.parent.topframe.document.getElementById(\"Pref\").className=\"TopMenu\";\n }\n\n if(status_Msg==\"\"|| status_Msg==\"STATUS_OK\" ){\n    setTimeout(\"fnShowDiv()\",3000);\n }\n\nfunction fnShowDiv(){\n    document.getElementById(\"msg_id\").style.display=\"none\";   \n    document.getElementById(\"boxData_id\").style.display=\"\";\n}\n\nfunction fnnOnLoad() {\n    gaImages[0] = \"/Graphics/checkbutton.gif\";\n    var getData =getQueryStringValue(\"sortValue\",\"self\");\n    if (getData == undefined || getData == \"\") {\n        lsSV=\"undefined\";\n        lsST = \"A\"  ;\n        gaImages[1] = \"/efiling/images/A-U.GIF\";\n    }\n    else {\n        var sortType =getQueryStringValue(\"sortType\",\"self\");\n        lsSV = getData;\n        if(sortType==\"A\"){\n            lsST = \"A\";\n            gaImages[1] = \"/efiling/images/A-U.GIF\";\n        }\n        else if (sortType==\"D\")  {\n            lsST = \"D\";\n            gaImages[1] = \"/efiling/images/A-D.GIF\";\n        }\n    }\n\n    var i,j=gaPreload.length;\n\n    for(i=0; i<gaImages.length; i++)\n    {\n        gaPreload[j] = new Image();\n        gaPreload[j++].src = gaImages[i];\n    }\n}\n\n\nfunction fnnAdminBoxList () {\n    if(status_Msg==\"STATUS_USER_EDITING\"){\n     document.getElementById(\"msg_id\").style.display=\"\";\n     showDivs(\"msg_delete\");\n    } else if(status_Msg==\"\"|| status_Msg==\"STATUS_OK\"){        \n        gblSETRequestXMLArray =[\"<FileStorages><FileStorage selected='1'><name>EFiling</name><